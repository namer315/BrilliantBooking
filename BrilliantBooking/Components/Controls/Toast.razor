@if (IsVisible)
{
    <div class="pointer-events-none fixed inset-x-4 top-4 z-[60] flex justify-center sm:left-auto sm:right-6 sm:inset-x-auto sm:w-[min(100%-3rem,28rem)] sm:justify-end"
         role="status"
         aria-live="polite"
         aria-atomic="true">
        <div class="pointer-events-auto w-full overflow-hidden rounded-2xl border border-stone-200/80 bg-white/95 shadow-apple-hover backdrop-blur-xl dark:border-stone-700/80 dark:bg-stone-900/95 @_accentClass"
             aria-labelledby="@_titleId"
             aria-describedby="@_messageId">
            <div class="flex items-start gap-3 p-4">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full @_iconBgClass">
                    <i class="fa-solid @_iconClass text-base @_iconTextClass" aria-hidden="true"></i>
                </div>
                <div class="min-w-0 flex-1 pt-0.5">
                    <p id="@_titleId" class="text-sm font-semibold text-apple-dark-gray dark:text-white">@Title</p>
                    <p id="@_messageId" class="mt-0.5 text-sm leading-relaxed text-stone-600 dark:text-stone-300">@Message</p>
                </div>
                <button type="button"
                        class="-m-1 shrink-0 rounded-full p-1 text-stone-400 transition-colors hover:bg-stone-100 hover:text-stone-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-apple-blue dark:hover:bg-stone-800 dark:hover:text-stone-200"
                        aria-label="Dismiss notification"
                        @onclick="HandleClose">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
            <div class="h-1 @_progressTrackClass" aria-hidden="true">
                <div class="toast-progress h-full w-full origin-left @_progressClass"></div>
            </div>
        </div>
    </div>
}
