@if (IsVisible)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm p-4 transition-opacity duration-200" role="presentation">
        <div class="w-full max-w-md rounded-2xl bg-white dark:bg-stone-900 shadow-apple-hover overflow-hidden transform transition-all duration-200 scale-100 @_accentClass"
             role="dialog"
             aria-modal="true"
             aria-labelledby="@_titleId"
             aria-describedby="@_messageId"
             tabindex="-1"
             @onkeydown="HandleKeyDown">
            <div class="flex items-start gap-4 p-6">
                <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full @_iconBgClass">
                    <i class="fa-solid @_iconClass text-lg @_iconTextClass" aria-hidden="true"></i>
                </div>
                <div class="flex-1 min-w-0">
                    <h2 id="@_titleId" class="text-lg font-semibold text-apple-dark-gray dark:text-white">@Title</h2>
                    <p id="@_messageId" class="mt-1 text-sm leading-relaxed text-stone-600 dark:text-stone-300">@Message</p>
                </div>
                <button type="button"
                        class="-m-1 rounded-full p-1 text-stone-400 hover:bg-stone-100 hover:text-stone-600 dark:hover:bg-stone-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-apple-blue"
                        aria-label="Close"
                        @onclick="HandleClose">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
            <div class="flex justify-center border-t border-stone-100 dark:border-stone-800 px-6 py-4">
                <button type="button"
                        class="min-w-[120px] rounded-full px-6 py-2 text-sm font-medium text-white transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 @_buttonClass"
                        @onclick="HandleClose">
                    OK
                </button>
            </div>
        </div>
    </div>
}
