@if (Page.LocationModalOpen)
{
    <div class="fixed inset-0 z-50 bg-black/40 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-[#F8F7F4] dark:bg-stone-900 w-full max-w-sm rounded-3xl p-6 shadow-2xl border border-stone-200 dark:border-stone-800 space-y-4">
            <div class="flex justify-between items-center">
                <h3 class="text-base font-bold">Select Dining Region</h3>
                <button @onclick="Page.ToggleLocationModal" class="p-1 text-stone-400 hover:text-black dark:hover:text-white">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>
            <div class="space-y-2">
                @foreach (var region in Page.Locations)
                {
                    <button @onclick='() => Page.SetLocation(region.Value)' class="w-full text-left px-4 py-3 rounded-xl border border-stone-200/80 dark:border-stone-800 hover:border-apple-blue hover:bg-apple-blue/5 transition text-sm font-semibold flex items-center justify-between">
                        <span>@region.Label</span>
                        @if (Page.Location == region.Value)
                        {
                            <i data-lucide="check" class="w-4 h-4 text-apple-blue"></i>
                        }
                    </button>
                }
            </div>
        </div>
    </div>
}
