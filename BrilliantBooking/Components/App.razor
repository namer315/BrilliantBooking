<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    @* <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" /> *@
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["BrilliantBooking.styles.css"]" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = { darkMode: 'class', theme: { extend: { colors: { apple: { blue: '#0071E3', 'blue-hover': '#0077ED', gray: '#F5F5F7', 'dark-gray': '#1D1D1F', green: '#34C759', orange: '#FF9500', red: '#FF3B30', purple: '#AF52DE' } }, boxShadow: { 'apple-glass': '0 8px 32px 0 rgba(0,0,0,.08)', 'apple-card': '0 4px 20px 0 rgba(0,0,0,.05)', 'apple-hover': '0 12px 28px 0 rgba(0,0,0,.12)' } } } };
    </script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
            tailwind.config = {
                darkMode: 'class',
                theme: {
                    extend: {
                        fontFamily: {
                            sans: ['-apple-system', 'BlinkMacSystemFont', '"SF Pro Display"', '"SF Pro Text"', '"Helvetica Neue"', 'sans-serif'],
                        },
                        colors: {
                            apple: {
                                blue: '#0071E3',
                                'blue-hover': '#0077ED',
                                gray: '#F5F5F7',
                                'dark-gray': '#1D1D1F',
                                green: '#34C759',
                                orange: '#FF9500',
                                red: '#FF3B30',
                                purple: '#AF52DE'
                            }
                        },
                        boxShadow: {
                            'apple-glass': '0 8px 32px 0 rgba(0, 0, 0, 0.08)',
                            'apple-card': '0 4px 20px 0 rgba(0, 0, 0, 0.05)',
                            'apple-hover': '0 12px 28px 0 rgba(0, 0, 0, 0.12)',
                        }
                    }
                }
            }
    </script>
    <script>
            window.refreshReserveIcons = () => { if (window.lucide) lucide.createIcons(); };
            window.setDarkMode = (enabled) => document.documentElement.classList.toggle('dark', enabled);
    </script>
    <link rel="stylesheet" href="@Assets["css/site.css"]" />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>
        window.refreshReserveIcons = function () { if (window.lucide) window.lucide.createIcons(); };
    </script>
</body>

</html>
