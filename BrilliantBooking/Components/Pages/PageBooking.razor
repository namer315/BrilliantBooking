@page "/Booking"
@page "/Booking/{Restaurant}"
@using Data.VO.Operations

@rendermode @(new InteractiveServerRenderMode(false))

<main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <section class="space-y-6">
        <div class="flex items-center justify-between border-b border-stone-200 dark:border-stone-800 pb-4">
            <a href="/Explore" class="flex items-center space-x-1.5 text-xs font-semibold text-apple-blue hover:underline">
                <i data-lucide="chevron-left" class="w-4 h-4"></i>
                <span>Back to Restaurants</span>
            </a>
            <div class="text-center">
                <h2 class="text-lg font-bold">@Booking.Restaurant.Name</h2>
                <p class="text-xs text-stone-500 dark:text-stone-400">@Booking.Restaurant.Location • @Booking.Restaurant.Cuisine</p>
            </div>
            <div class="w-20"></div>
        </div>

        <div class="max-w-xl mx-auto">
            <div class="flex items-center justify-between text-xs font-medium text-stone-500 mb-2">
                <span class="@(Booking.Step == 1 ? "text-apple-blue font-bold" : "")">1. Time &amp; Guests</span>
                <span class="@(Booking.Step == 2 ? "text-apple-blue font-bold" : "")">2. Select Table</span>
                <span class="@(Booking.Step == 3 ? "text-apple-blue font-bold" : "")">3. Guest Details</span>
                <span class="@(Booking.Step == 4 ? "text-apple-blue font-bold" : "")">4. Confirmation</span>
            </div>
            <div class="w-full bg-stone-200 dark:bg-stone-800 h-1.5 rounded-full overflow-hidden">
                <div class="bg-apple-blue h-full transition-all duration-300" style="width: @(Booking.Step * 25)%"></div>
            </div>
        </div>

        @if (Booking.Step == 1)
        {
            <div class="max-w-2xl mx-auto bg-[#F8F7F4] dark:bg-stone-900 rounded-3xl p-6 md:p-8 shadow-apple-card border border-stone-200/80 dark:border-stone-800 space-y-6">
                <h3 class="text-base font-bold flex items-center space-x-2">
                    <i data-lucide="users" class="w-5 h-5 text-apple-blue"></i>
                    <span>Select Party Size &amp; Date</span>
                </h3>

                <div>
                    <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-2">Party Size</label>
                    <div class="flex items-center space-x-2 overflow-x-auto pb-2">
                        @for (var i = 1 ; i <= 8 ; i++)
                        {
                            var guests = i;
                            <button @onclick='() => Booking.GuestCount = guests' class="px-4 py-2.5 rounded-xl border text-sm font-semibold transition @(Booking.GuestCount == guests ? "border-apple-blue bg-apple-blue text-white" : "border-stone-300/80 dark:border-stone-700 hover:border-apple-blue")">@guests @(guests == 1 ? "Guest" : "Guests")</button>
                        }
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-2">Select Date</label>
                    <div class="grid grid-cols-3 gap-2 mb-3">
                        @foreach (var shortcut in DateShortcuts)
                        {
                            @*"onclick='() => Page.SelectDateShortcut(shortcut.Offset)'*@
                            <button class="py-2.5 px-3 rounded-xl text-xs font-semibold text-center border @(DateShortcuts[0].Offset == shortcut.Offset ? "border-apple-blue bg-apple-blue/10 text-apple-blue" : "border-stone-300/80 dark:border-stone-700 hover:border-apple-blue")">@shortcut.Label</button>
                        }
                    </div>
                    <input type="date" value="@Booking.Date" @onchange="e => Booking.Date = DateOnly.FromDateTime(Convert.ToDateTime(e.Value ?? DateTime.UtcNow))" class="w-full bg-[#F0EEE9] dark:bg-stone-800 border border-stone-300/80 dark:border-stone-700 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue" />
                </div>

                <div>
                    <div class="flex items-center justify-between mb-2">
                        <label class="text-xs font-semibold text-stone-500 uppercase tracking-wider">Dining Window</label>
                        <span class="text-xs text-apple-green font-medium flex items-center space-x-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-apple-green"></span>
                            <span>Choose your dining window</span>
                        </span>
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label for="booking-from-time" class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-2">From Time</label>
                            <input id="booking-from-time" type="time" value="@Booking.FromTime.ToString(@"hh\:mm")" @onchange="e => { if (TimeSpan.TryParse(e.Value?.ToString() , out var from)) Booking.FromTime = from; }" class="w-full bg-[#F0EEE9] dark:bg-stone-800 border border-stone-300/80 dark:border-stone-700 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue" />
                        </div>
                        <div>
                            <label for="booking-to-time" class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-2">To Time</label>
                            <input id="booking-to-time" type="time" value="@Booking.ToTime.ToString(@"hh\:mm")" @onchange="e => { if (TimeSpan.TryParse(e.Value?.ToString() , out var to)) Booking.ToTime = to; }" class="w-full bg-[#F0EEE9] dark:bg-stone-800 border border-stone-300/80 dark:border-stone-700 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue" />
                        </div>
                    </div>
                    @*<div class="grid grid-cols-3 sm:grid-cols-4 gap-2.5">
                         @for (var idx = 0 ; idx < Booking.Restaurant.Slots.Length ; idx++)
                        {
                            var slot = Page.BookingRestaurant.Slots[idx];
                            <button @onclick='() => Page.TimeSlot = slot' class="py-3 px-3 rounded-xl border text-xs font-bold text-center transition @(Page.TimeSlot == slot ? "border-apple-blue bg-apple-blue text-white" : "border-stone-300/80 dark:border-stone-700 hover:border-apple-blue")">
                                <div>@slot</div>
                                <div class="text-[9px] font-normal opacity-80">@(idx % 2 == 0 ? "High Demand" : "3 Tables Left")</div>
                            </button>
                        } 
                    </div>*@
                </div>
                @*disabled="(Page.TimeSlot is null)"*@
                <button @onclick='() => GoToBookingStep(2)' class="w-full py-3.5 bg-apple-blue hover:bg-apple-blue-hover text-white font-semibold rounded-2xl shadow-lg shadow-apple-blue/20 transition flex items-center justify-center space-x-2 text-sm" >
                    <span>Continue to Table Selection</span>
                    <i data-lucide="arrow-right" class="w-4 h-4"></i>
                </button>
            </div>
        }

        @if (Booking.Step == 2)
        {
            <div class="max-w-4xl mx-auto space-y-4">
                <div class="bg-[#F8F7F4] dark:bg-stone-900 rounded-3xl p-6 shadow-apple-card border border-stone-200/80 dark:border-stone-800 space-y-4">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                        <div>
                            <h3 class="text-base font-bold flex items-center space-x-2">
                                <i data-lucide="layout" class="w-5 h-5 text-apple-blue"></i>
                                <span>Choose Your Table &amp; Dining Zone</span>
                            </h3>
                            <p class="text-xs text-stone-500 dark:text-stone-400">Tap an available table on the floorplan map below</p>
                        </div>
                        <div class="flex items-center space-x-3 text-xs">
                            <span class="flex items-center space-x-1"><span class="w-3 h-3 rounded-full bg-emerald-500"></span> <span>Available</span></span>
                            <span class="flex items-center space-x-1"><span class="w-3 h-3 rounded-full bg-apple-blue"></span> <span>Selected</span></span>
                            <span class="flex items-center space-x-1"><span class="w-3 h-3 rounded-full bg-stone-400"></span> <span>Reserved</span></span>
                        </div>
                    </div>
                    
                    <div class="relative w-full border border-stone-300/70 dark:border-stone-800 rounded-2xl bg-[#EFECE6] dark:bg-stone-950 p-4 overflow-auto h-[420px]">
                        @if (Booking.Restaurant?.FloorList.SelectMany(floor => floor.TableList) is IList<TableVO> tables && tables is { Count: > 0 })
                        {
                            var (layout, canvasHeight) = BuildFloorLayout(tables);
                            <svg viewBox="0 0 800 @canvasHeight" class="w-full h-auto select-none" role="group" aria-label="Floor plan">
                                @foreach (var (table, cx, cy, _) in layout)
                                {
                                    var seats = Math.Max(table.GuestCount, 1);
                                    var isSelected = Booking.TableName == table.Name;
                                    var tooSmall = seats < Booking.GuestCount;
                                    var fill = isSelected ? "#0A84FF" : tooSmall ? "#9CA3AF" : "#34C759";
                                    var stroke = isSelected ? "#0A84FF" : tooSmall ? "#9CA3AF" : "#34C759";
                                    var width = 60 + seats * 10;
                                    var radius = 22 + seats * 3;
                                    var textColor = isSelected ? "#FFFFFF" : "#1F2937";
                                    var subColor = isSelected ? "#FFFFFF" : "#6B7280";

                                    <g @onclick="() => SelectTable(table)"
                                       class="@(tooSmall ? "cursor-not-allowed" : "cursor-pointer") transition"
                                       opacity="@(tooSmall ? "0.5" : "1")"
                                       role="button"
                                       aria-disabled="@tooSmall.ToString().ToLower()">
                                        @if (seats <= 2)
                                        {
                                            <circle cx="@cx" cy="@cy" r="@radius" fill="@fill" fill-opacity="@(isSelected ? "1" : "0.2")" stroke="@stroke" stroke-width="3" />
                                        }
                                        else
                                        {
                                            <rect x="@(cx - width / 2)" y="@(cy - 35)" width="@width" height="70" rx="14" fill="@fill" fill-opacity="@(isSelected ? "1" : "0.2")" stroke="@stroke" stroke-width="3" />
                                        }
                                        <text x="@cx" y="@(cy - 2)" text-anchor="middle" font-size="13" font-weight="bold" fill="@textColor">@table.Name</text>
                                        <text x="@cx" y="@(cy + 16)" text-anchor="middle" font-size="11" fill="@subColor">@table.GuestCount seats</text>
                                    </g>
                                }
                            </svg>
                        }
                        else
                        {
                            <p class="text-center text-xs text-stone-500">No tables are available for this restaurant.</p>
                        }
                        @*<svg viewBox="0 0 800 450" class="w-full h-auto max-h-[420px] select-none">
                             <rect x="20" y="20" width="460" height="410" rx="20" fill="none" stroke="#E5E7EB" stroke-dasharray="4" stroke-width="2" />
                            <text x="40" y="45" font-size="12" font-weight="bold" fill="#9CA3AF">MAIN DINING ROOM</text>

                            <rect x="510" y="20" width="270" height="410" rx="20" fill="none" stroke="#E5E7EB" stroke-dasharray="4" stroke-width="2" />
                            <text x="530" y="45" font-size="12" font-weight="bold" fill="#9CA3AF">OCEAN TERRACE PATIO</text>

                            <g class="table-node @(Page.IsSelectedTable("Table 01") ? "selected" : "")" @onclick='() => Page.SelectFloorTable(Page.FloorTables[0])'>
                                <circle cx="100" cy="120" r="35" fill="#34C759" fill-opacity="0.2" stroke="#34C759" stroke-width="3" />
                                <text x="100" y="124" text-anchor="middle" font-size="12" font-weight="bold" fill="#1F2937">T-01</text>
                                <text x="100" y="170" text-anchor="middle" font-size="10" fill="#6B7280">4 Seats</text>
                            </g>

                            <g class="table-node occupied">
                                <circle cx="240" cy="120" r="35" fill="#9CA3AF" fill-opacity="0.3" stroke="#9CA3AF" stroke-width="2" />
                                <text x="240" y="124" text-anchor="middle" font-size="12" font-weight="bold" fill="#6B7280">T-02</text>
                                <text x="240" y="170" text-anchor="middle" font-size="10" fill="#9CA3AF">Reserved</text>
                            </g>

                            <g class="table-node @(Page.IsSelectedTable("Table 04") ? "selected" : "")" @onclick='() => Page.SelectFloorTable(Page.FloorTables[1])'>
                                <rect x="340" y="85" width="90" height="70" rx="12" fill="#34C759" fill-opacity="0.2" stroke="#34C759" stroke-width="3" />
                                <text x="385" y="125" text-anchor="middle" font-size="12" font-weight="bold" fill="#1F2937">Table 04</text>
                                <text x="385" y="175" text-anchor="middle" font-size="10" fill="#6B7280">Booth (4-6)</text>
                            </g>

                            <g class="table-node @(Page.IsSelectedTable("Chef Counter 12") ? "selected" : "")" @onclick='() => Page.SelectFloorTable(Page.FloorTables[2])'>
                                <rect x="80" y="280" width="140" height="50" rx="10" fill="#34C759" fill-opacity="0.2" stroke="#34C759" stroke-width="3" />
                                <text x="150" y="310" text-anchor="middle" font-size="12" font-weight="bold" fill="#1F2937">Chef's Counter</text>
                            </g>

                            <g class="table-node @(Page.IsSelectedTable("Patio P1") ? "selected" : "")" @onclick='() => Page.SelectFloorTable(Page.FloorTables[3])'>
                                <circle cx="600" cy="140" r="30" fill="#34C759" fill-opacity="0.2" stroke="#34C759" stroke-width="3" />
                                <text x="600" y="144" text-anchor="middle" font-size="11" font-weight="bold" fill="#1F2937">Patio P1</text>
                            </g>

                            <g class="table-node @(Page.IsSelectedTable("Patio P2") ? "selected" : "")" @onclick='() => Page.SelectFloorTable(Page.FloorTables[4])'>
                                <circle cx="700" cy="260" r="38" fill="#34C759" fill-opacity="0.2" stroke="#34C759" stroke-width="3" />
                                <text x="700" y="264" text-anchor="middle" font-size="12" font-weight="bold" fill="#1F2937">Patio P2</text>
                            </g> 
                        </svg>*@
                    </div>

                    <div class="bg-apple-blue/5 border border-apple-blue/20 rounded-2xl p-4 flex items-center justify-between">
                        <div class="flex items-center space-x-3">
                            <div class="w-10 h-10 rounded-xl bg-apple-blue text-white flex items-center justify-center font-bold text-base">
                                <i data-lucide="armchair" class="w-5 h-5"></i>
                            </div>
                            <div>
                                <h4 class="text-sm font-bold">@(Booking.Table?.Name ?? "No Table Selected")</h4>
                                <p class="text-xs text-stone-500">@(Booking.Table is null ? "Select a highlighted table from the dining floor plan above" : $"{Booking.Table?.Description} ({Booking.Table?.Capacity} seats max)")</p>
                            </div>
                        </div>
                        <span class="px-2.5 py-1 rounded-full text-xs font-semibold @(Booking.TableName is null ? "bg-stone-200 dark:bg-stone-800 text-stone-600 dark:text-stone-300" : "bg-apple-green text-white")">@(Booking.Table is null ? "Required" : "Selected")</span>
                    </div>

                    <div class="flex items-center justify-between pt-2">
                        <button @onclick='() => GoToBookingStep(1)' class="px-5 py-2.5 border border-stone-300/80 dark:border-stone-700 text-xs font-semibold rounded-xl hover:bg-stone-200/50 dark:hover:bg-stone-800 transition">Back</button>
                        <button @onclick='() => GoToBookingStep(3)' class="px-6 py-2.5 bg-apple-blue disabled:opacity-50 hover:bg-apple-blue-hover text-white text-xs font-semibold rounded-xl shadow-md transition flex items-center space-x-1.5">
                            <span>Proceed to Guest Details</span>@*disabled="@(Page.SelectedTable is null)"*@
                            <i data-lucide="chevron-right" class="w-4 h-4"></i>
                        </button>
                    </div>
                </div>
            </div>
        }

        @if (Booking.Step == 3)
        {
            <div class="max-w-2xl mx-auto bg-[#F8F7F4] dark:bg-stone-900 rounded-3xl p-6 md:p-8 shadow-apple-card border border-stone-200/80 dark:border-stone-800 space-y-6">
                <h3 class="text-base font-bold flex items-center space-x-2">
                    <i data-lucide="user-check" class="w-5 h-5 text-apple-blue"></i>
                    <span>Contact Information &amp; Dietary Notes</span>
                </h3>

                <form @onsubmit="SubmitGuestDetails" @onsubmit:preventDefault class="space-y-4">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Full Name *</label>
                            <input type="text" @bind="Booking.GuestName" @bind:event="oninput" required placeholder="e.g. Johnathan Vance" class="w-full bg-[#F0EEE9] dark:bg-stone-800 border border-stone-300/80 dark:border-stone-700 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Mobile Phone *</label>
                            <input type="tel" @bind="Booking.GuestPhone" @bind:event="oninput" required placeholder="+27 82 123 4567" class="w-full bg-[#F0EEE9] dark:bg-stone-800 border border-stone-300/80 dark:border-stone-700 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Email Address *</label>
                        <input type="email" @bind="Booking.GuestEmail" @bind:event="oninput" required placeholder="johnathan@example.com" class="w-full bg-[#F0EEE9] dark:bg-stone-800 border border-stone-300/80 dark:border-stone-700 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue" />
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-2">Special Occasion</label>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var occasion in Occasions)
                            {
                                var value = occasion;
                                <button type="button" @onclick='() => ToggleOccasion(value)' class="px-3 py-1.5 rounded-full border text-xs font-medium hover:border-apple-blue transition @(Booking.Occasion == value ? "bg-apple-blue text-white border-apple-blue" : "border-stone-300/80 dark:border-stone-700")">@value</button>
                            }
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-2">Dietary Requirements</label>
                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                            @foreach (var diet in DietaryOptions)
                            {
                                var value = diet;
                                <label class="flex items-center space-x-2 text-xs font-medium p-2 border border-stone-300/80 dark:border-stone-700 rounded-xl cursor-pointer hover:bg-stone-200/50 dark:hover:bg-stone-800">
                                    <input type="checkbox" checked="@Booking.Dietary.Contains(value)" @onchange="() => ToggleDietary(value)" class="rounded text-apple-blue focus:ring-apple-blue" />
                                    <span>@value</span>
                                </label>
                            }
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Special Requests / Notes</label>
                        <textarea @bind="Booking.Note" @bind:event="oninput" rows="2" placeholder="High chair needed, quiet area preference, champagne on arrival..." class="w-full bg-[#F0EEE9] dark:bg-stone-800 border border-stone-300/80 dark:border-stone-700 rounded-xl p-3 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue"></textarea>
                    </div>

                    <div class="flex items-center justify-between pt-4">
                        <button type="button" @onclick='() => GoToBookingStep(2)' class="px-5 py-2.5 border border-stone-300/80 dark:border-stone-700 text-xs font-semibold rounded-xl hover:bg-stone-200/50 dark:hover:bg-stone-800 transition">Back</button>
                        <button type="submit" class="px-6 py-2.5 bg-apple-blue hover:bg-apple-blue-hover text-white text-xs font-semibold rounded-xl shadow-md transition flex items-center space-x-1.5">
                            <span>Review Booking</span>
                            <i data-lucide="chevron-right" class="w-4 h-4"></i>
                        </button>
                    </div>
                </form>
            </div>
        }

        @if (Booking.Step == 4)
        {
            <div class="max-w-xl mx-auto space-y-6">
                @if (!Booking.BookingConfirmed)
                {
                    <div class="bg-[#F8F7F4] dark:bg-stone-900 rounded-3xl p-6 md:p-8 shadow-apple-card border border-stone-200/80 dark:border-stone-800 space-y-6">
                        <div class="text-center space-y-2">
                            <div class="w-12 h-12 bg-apple-blue/10 text-apple-blue rounded-2xl mx-auto flex items-center justify-center">
                                <i data-lucide="shield-check" class="w-6 h-6"></i>
                            </div>
                            <h3 class="text-xl font-bold">Review Reservation Details</h3>
                            <p class="text-xs text-stone-500">Please confirm your reservation parameters below</p>
                        </div>

                        <div class="bg-[#F0EEE9] dark:bg-stone-800/50 rounded-2xl p-4 space-y-3 text-sm border border-stone-200/60 dark:border-stone-800">
                            <div class="flex justify-between pb-2 border-b border-stone-200 dark:border-stone-700">
                                <span class="text-stone-500 text-xs">Restaurant</span>
                                <span class="font-bold text-xs">@Booking.Restaurant.Name</span>
                            </div>
                            @* <div class="flex justify-between pb-2 border-b border-stone-200 dark:border-stone-700">
                                <span class="text-stone-500 text-xs">Date &amp; Time</span>
                                <span class="font-semibold text-xs">@Booking.Date at @Booking.Time</span>
                            </div> *@
                            <div class="flex justify-between pb-2 border-b border-stone-200 dark:border-stone-700">
                                <span class="text-stone-500 text-xs">Date &amp; Time</span>
                                <dd class="font-semibold text-xs text-right m-0">@Booking.Date.ToString("dddd, MMM d") <span class="font-normal text-stone-500">@TimeOnly.FromTimeSpan(Booking.FromTime).ToString("h:mm tt") – @TimeOnly.FromTimeSpan(Booking.ToTime).ToString("h:mm tt")</span></dd>
                            </div>
                            <div class="flex justify-between pb-2 border-b border-stone-200 dark:border-stone-700">
                                <span class="text-stone-500 text-xs">Party Size</span>
                                <span class="font-semibold text-xs">@Booking.GuestCount Guests</span>
                            </div>
                            <div class="flex justify-between pb-2 border-b border-stone-200 dark:border-stone-700">
                                <span class="text-stone-500 text-xs">Seating Area / Table</span>
                                <span class="font-semibold text-apple-blue text-xs">@(Booking.Table?.Name ?? "Host Selected")</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-stone-500 text-xs">Guest</span>
                                <span class="font-semibold text-xs">@Booking.GuestName</span>
                            </div>
                        </div>

                        <div class="flex items-start space-x-2 text-xs text-stone-500 bg-amber-50 dark:bg-amber-950/30 p-3 rounded-xl border border-amber-200 dark:border-amber-900/50">
                            <i data-lucide="info" class="w-4 h-4 text-amber-600 flex-shrink-0 mt-0.5"></i>
                            <span>15-minute grace period applied. Free cancellation up to 2 hours prior to reservation time.</span>
                        </div>

                        <div class="space-y-2">
                            <p class="text-xs text-stone-500 text-center leading-relaxed">Review your details above. Once confirmed, your table is held instantly and a confirmation will be sent to you.</p>
                            <button @onclick="ConfirmBooking" class="w-full py-3.5 bg-black dark:bg-white text-white dark:text-black font-semibold rounded-2xl shadow-xl hover:opacity-90 transition flex items-center justify-center space-x-2 text-sm">
                                <i data-lucide="calendar-check" class="w-5 h-5 mb-0.5"></i>
                                <span>Confirm Booking</span>
                            </button>
                            <button @onclick='() => GoToBookingStep(3)' class="w-full py-2.5 text-xs text-stone-500 font-medium hover:underline">Modify Information</button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="bg-[#F8F7F4] dark:bg-stone-900 rounded-3xl p-6 md:p-8 shadow-2xl border border-apple-green/30 text-center space-y-6">
                        <div class="space-y-2">
                            <div class="w-16 h-16 bg-apple-green text-white rounded-full mx-auto flex items-center justify-center shadow-lg shadow-apple-green/30">
                                <i data-lucide="check" class="w-8 h-8"></i>
                            </div>
                            <p class="text-xs font-bold uppercase tracking-widest text-apple-green">Reservation Confirmed</p>
                            <h3 class="text-2xl font-black mt-1">We look forward to serving you!</h3>
                            <p class="text-xs text-stone-500 mt-1">Confirmation code sent to your email &amp; mobile</p>
                        </div>

                        <div class="bg-[#F0EEE9] dark:bg-stone-800 p-6 rounded-2xl border border-stone-200/80 dark:border-stone-700 flex flex-col items-center space-y-3">
                            <span class="text-xs font-semibold text-stone-400">BOOKING REFERENCE CODE</span>
                            <span class="font-mono text-2xl font-extrabold text-apple-blue tracking-wider">@Booking.ConfirmationCode</span>
                            <div class="w-32 h-32 bg-[#F8F7F4] p-2 rounded-xl border border-stone-300 flex items-center justify-center">
                                <svg class="w-full h-full text-black" viewBox="0 0 100 100">
                                    <path fill="currentColor" d="M10 10h30v30H10zM50 10h40v10H50zM60 30h30v20H60zM10 50h20v40H10zM40 60h20v30H40zM70 70h20v20H70z" />
                                </svg>
                            </div>
                            <span class="text-[10px] text-stone-400">Present this QR code upon arrival at the host stand</span>
                        </div>

                        <div class="flex flex-col sm:flex-row gap-2">
                            <button @onclick="Save" class="flex-1 py-3 bg-black dark:bg-stone-800 text-white font-medium text-xs rounded-xl flex items-center justify-center space-x-2 border border-stone-700">
                                <i data-lucide="wallet" class="w-4 h-4"></i>
                                <span>Add to Apple Wallet</span>
                            </button>
                            <button @onclick="ViewMyBookings" class="flex-1 py-3 bg-apple-blue text-white font-medium text-xs rounded-xl hover:bg-apple-blue-hover transition">View My Bookings</button>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
</main>