@page "/"
@page "/reserve"
@rendermode InteractiveServer
@inherits HomeBase

<PageTitle>Tableau Reserve — Premium Table Reservations</PageTitle>

<HeadContent>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['-apple-system', 'BlinkMacSystemFont', '"SF Pro Display"', '"SF Pro Text"', '"Helvetica Neue"', 'sans-serif'],
                    },
                    colors: {
                        apple: {
                            blue: '#0071E3',
                            'blue-hover': '#0077ED',
                            gray: '#F5F5F7',
                            'dark-gray': '#1D1D1F',
                            green: '#34C759',
                            orange: '#FF9500',
                            red: '#FF3B30',
                            purple: '#AF52DE'
                        }
                    },
                    boxShadow: {
                        'apple-glass': '0 8px 32px 0 rgba(0, 0, 0, 0.08)',
                        'apple-card': '0 4px 20px 0 rgba(0, 0, 0, 0.05)',
                        'apple-hover': '0 12px 28px 0 rgba(0, 0, 0, 0.12)',
                    }
                }
            }
        }
    </script>
    <script>
        window.refreshReserveIcons = () => { if (window.lucide) lucide.createIcons(); };
        window.setDarkMode = (enabled) => document.documentElement.classList.toggle('dark', enabled);
    </script>
    <style>
        body {
            font-feature-settings: "cv02", "cv03", "cv04", "cv11";
            -webkit-font-smoothing: antialiased;
            background-color: #F8F7F4;
            color: #1C1B1A;
        }
        .dark body {
            background-color: #121110;
            color: #F5F4F0;
        }
        .sf-glass {
            background: rgba(248, 247, 244, 0.78);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.6);
        }
        .dark .sf-glass {
            background: rgba(26, 25, 23, 0.78);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .sf-glass-nav {
            background: rgba(248, 247, 244, 0.85);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border-bottom: 1px solid rgba(0, 0, 0, 0.06);
        }
        .dark .sf-glass-nav {
            background: rgba(18, 17, 16, 0.85);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }
        .sf-segmented {
            background: rgba(120, 120, 128, 0.12);
            padding: 2px;
            border-radius: 9px;
        }
        .sf-segmented button.active {
            background: #F8F7F4;
            box-shadow: 0px 3px 8px rgba(0, 0, 0, 0.1), 0px 3px 1px rgba(0, 0, 0, 0.04);
            border-radius: 7px;
            color: #1C1B1A;
        }
        .dark .sf-segmented button.active {
            background: #2D2B28;
            color: #FFF;
        }
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(0, 0, 0, 0.15);
            border-radius: 10px;
        }
        .dark ::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.2);
        }
        .table-node {
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
            cursor: pointer;
        }
        .table-node:hover {
            transform: scale(1.05);
            filter: drop-shadow(0 4px 8px rgba(0,0,0,0.15));
        }
        .table-node.selected circle, .table-node.selected rect {
            fill: #0071E3 !important;
            stroke: #0071E3 !important;
        }
        .table-node.selected text {
            fill: #FFFFFF !important;
        }
        .table-node.occupied {
            cursor: not-allowed;
            opacity: 0.5;
        }
        .view-section {
            display: none;
        }
        .view-section.active {
            display: block;
        }
    </style>
</HeadContent>

<div class="min-h-screen flex flex-col antialiased selection:bg-apple-blue selection:text-white">
    <!-- TOP HEADER / APPLE NAVIGATION BAR -->
    <header class="sticky top-0 z-40 sf-glass-nav transition-colors duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-4">
                <a href="#" @onclick='() => SwitchView("explore")' @onclick:preventDefault class="flex items-center space-x-2 text-xl font-semibold tracking-tight">
                    <span class="w-8 h-8 rounded-xl bg-apple-blue flex items-center justify-center text-white shadow-md shadow-apple-blue/30">
                        <i data-lucide="utensils" class="w-4 h-4"></i>
                    </span>
                    <span class="bg-gradient-to-r from-stone-900 via-stone-800 to-stone-900 dark:from-white dark:to-stone-300 bg-clip-text text-transparent font-bold">
                        Tableau <span class="text-apple-blue font-normal">Reserve</span>
                    </span>
                </a>

                <div class="hidden md:flex items-center space-x-1.5 px-3 py-1.5 rounded-full bg-black/5 dark:bg-white/10 text-xs font-medium cursor-pointer hover:bg-black/10 transition" @onclick="ToggleLocationModal">
                    <i data-lucide="map-pin" class="w-3.5 h-3.5 text-apple-blue"></i>
                    <span>@Location</span>
                    <i data-lucide="chevron-down" class="w-3 h-3 text-stone-400"></i>
                </div>
            </div>

            <nav class="hidden lg:flex items-center space-x-1 sf-segmented p-1">
                <button @onclick='() => SwitchView("explore")' class="@(View == "explore" ? "active bg-white dark:bg-gray-700 text-black dark:text-white" : "text-stone-600 dark:text-stone-300") px-4 py-1.5 text-xs font-medium rounded-md transition-all">Explore</button>
                <button @onclick='() => SwitchView("bookings")' class="@(View == "bookings" ? "active bg-white dark:bg-gray-700 text-black dark:text-white" : "text-stone-600 dark:text-stone-300") px-4 py-1.5 text-xs font-medium rounded-md transition-all">My Bookings</button>
                <button @onclick='() => SwitchView("ops")' class="@(View == "ops" ? "active bg-white dark:bg-gray-700 text-black dark:text-white" : "text-stone-600 dark:text-stone-300") px-4 py-1.5 text-xs font-medium rounded-md transition-all flex items-center space-x-1">
                    <span class="w-2 h-2 rounded-full bg-apple-green animate-pulse"></span>
                    <span>Live Operations</span>
                </button>
            </nav>

            <div class="flex items-center space-x-3">
                <button @onclick="ToggleFavoritesOnlyFilter" class="px-3 py-1.5 rounded-full bg-stone-200/60 dark:bg-stone-800 text-xs font-semibold flex items-center space-x-1 hover:bg-stone-300/60 transition @(FavoritesOnly ? "bg-apple-red/20 text-apple-red border border-apple-red/40" : "")">
                    <i data-lucide="heart" class="w-3.5 h-3.5 text-apple-red"></i>
                    <span>Saved (@Favorites.Count)</span>
                </button>

                <button @onclick="ToggleTheme" class="p-2 rounded-full hover:bg-black/5 dark:hover:bg-white/10 transition text-stone-600 dark:text-stone-300" title="Toggle Light/Dark Theme">
                    <i data-lucide="moon" class="w-4 h-4 hidden dark:block"></i>
                    <i data-lucide="sun" class="w-4 h-4 block dark:hidden"></i>
                </button>

                <button @onclick="ToggleMobileMenu" class="lg:hidden p-2 rounded-xl hover:bg-black/5 dark:hover:bg-white/10 transition">
                    <i data-lucide="menu" class="w-5 h-5"></i>
                </button>
            </div>
        </div>

        @if (MobileMenuOpen)
        {
            <div class="lg:hidden border-b border-stone-200 dark:border-stone-800 bg-[#F8F7F4]/95 dark:bg-stone-900/95 backdrop-blur-xl px-4 py-3 space-y-2">
                <button @onclick='() => SwitchView("explore")' class="w-full text-left px-3 py-2 rounded-lg text-sm font-medium hover:bg-stone-200/50 dark:hover:bg-stone-800">Explore Restaurants</button>
                <button @onclick='() => SwitchView("bookings")' class="w-full text-left px-3 py-2 rounded-lg text-sm font-medium hover:bg-stone-200/50 dark:hover:bg-stone-800">My Reservations</button>
                <button @onclick='() => SwitchView("ops")' class="w-full text-left px-3 py-2 rounded-lg text-sm font-medium hover:bg-stone-200/50 dark:hover:bg-stone-800 flex items-center justify-between">
                    <span>Restaurant Staff Operations</span>
                    <span class="text-xs bg-apple-green/20 text-apple-green font-semibold px-2 py-0.5 rounded-full">Live</span>
                </button>
            </div>
        }
    </header>

    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

        @* VIEW 1: EXPLORE *@
        @if (View == "explore")
        {
            <section class="space-y-8">
                <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-stone-900 via-stone-800 to-black text-white p-8 md:p-12 shadow-2xl">
                    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:16px_16px]"></div>

                    <div class="relative z-10 max-w-2xl space-y-4">
                        <span class="inline-flex items-center space-x-1 px-3 py-1 rounded-full bg-white/10 text-xs font-semibold tracking-wide backdrop-blur-md border border-white/20">
                            <i data-lucide="sparkles" class="w-3.5 h-3.5 text-apple-orange"></i>
                            <span>Curated Fine Dining Experiences</span>
                        </span>
                        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight">Reserve tables at Cape Town's finest venues.</h1>
                        <p class="text-stone-300 text-sm sm:text-base leading-relaxed">Experience effortless real-time table layout selection, instant confirmations, verified diner reviews, and concierge directions.</p>
                    </div>

                    <div class="relative z-10 mt-8 max-w-4xl">
                        <div class="sf-glass p-2.5 rounded-2xl shadow-xl flex flex-col md:flex-row items-center space-y-2 md:space-y-0 md:space-x-2 border border-white/30 text-stone-900 dark:text-white">
                            <div class="flex-grow flex items-center space-x-2 px-3 py-2 w-full">
                                <i data-lucide="search" class="w-4 h-4 text-stone-400"></i>
                                <input type="text" @bind="SearchText" @bind:event="oninput" placeholder="Search restaurants, cuisines, or neighbourhoods..." class="bg-transparent w-full text-sm focus:outline-none placeholder-stone-400" />
                            </div>
                            <div class="flex items-center space-x-2 w-full md:w-auto">
                                <select @bind="CuisineFilter" class="bg-[#F0EEE9] dark:bg-stone-800 text-xs font-semibold py-2.5 px-3 rounded-xl focus:outline-none cursor-pointer border border-stone-200 dark:border-stone-700">
                                    @foreach (var cuisine in Cuisines)
                                    {
                                        <option value="@cuisine.Value">@cuisine.Label</option>
                                    }
                                </select>
                                <select @bind="PriceFilter" class="bg-[#F0EEE9] dark:bg-stone-800 text-xs font-semibold py-2.5 px-3 rounded-xl focus:outline-none cursor-pointer border border-stone-200 dark:border-stone-700">
                                    @foreach (var price in Prices)
                                    {
                                        <option value="@price.Value">@price.Label</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex items-center space-x-2 overflow-x-auto pb-2 scrollbar-none">
                    @foreach (var category in Categories)
                    {
                        <button @onclick='() => SetCuisine(category.Value)' class="px-4 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition shadow-sm border @(CuisineFilter == category.Value ? "border-apple-blue bg-apple-blue text-white" : "border-stone-300/60 dark:border-stone-800 bg-[#F8F7F4] dark:bg-stone-900 text-stone-700 dark:text-stone-300 hover:border-apple-blue")">@category.Label</button>
                    }
                </div>

                <div>
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-xl font-bold tracking-tight">Available Restaurants</h2>
                        <span class="text-xs text-stone-500 dark:text-stone-400 font-medium">Showing @FilteredRestaurants.Count venue@(FilteredRestaurants.Count == 1 ? "" : "s")</span>
                    </div>

                    @if (!FilteredRestaurants.Any())
                    {
                        <div class="text-center py-16 space-y-3">
                            <i data-lucide="search-x" class="w-12 h-12 text-stone-400 mx-auto"></i>
                            <p class="text-base font-bold text-stone-600 dark:text-stone-300">No restaurants found matching your criteria.</p>
                            <button @onclick="ResetFilters" class="px-4 py-2 bg-apple-blue text-white text-xs font-semibold rounded-xl">Clear All Filters</button>
                        </div>
                    }
                    else
                    {
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                            @foreach (var item in FilteredRestaurants)
                            {
                                <div class="sf-glass rounded-3xl overflow-hidden shadow-apple-card hover:shadow-apple-hover transition-all duration-300 transform hover:-translate-y-1 flex flex-col justify-between border border-stone-200/80 dark:border-stone-800 cursor-pointer group" @onclick='() => OpenRestaurant(item)'>
                                    <div>
                                        <div class="relative h-52 w-full overflow-hidden">
                                            <img src="@item.Image" alt="@item.Name" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                                            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>

                                            <span class="absolute top-3 left-3 bg-black/60 backdrop-blur-md text-white text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider border border-white/20">@item.Badge</span>

                                            <button @onclick='() => ToggleFavorite(item)' @onclick:stopPropagation class="absolute top-3 right-3 w-8 h-8 rounded-full bg-black/50 text-white backdrop-blur-md flex items-center justify-center hover:scale-110 transition">
                                                <i data-lucide="heart" class="w-4 h-4 @(Favorites.Contains(item.Id) ? "text-apple-red fill-apple-red" : "text-white")"></i>
                                            </button>

                                            <span class="absolute bottom-3 right-3 bg-[#F8F7F4]/90 dark:bg-black/90 backdrop-blur-md text-stone-900 dark:text-white text-xs font-bold px-2.5 py-1 rounded-full">@item.Price</span>
                                        </div>

                                        <div class="p-5 space-y-2">
                                            <div class="flex items-center justify-between">
                                                <span class="text-xs font-semibold text-apple-blue uppercase tracking-wide">@item.Cuisine</span>
                                                <div class="flex items-center space-x-1 text-xs font-bold text-amber-500">
                                                    <i data-lucide="star" class="w-3.5 h-3.5 fill-amber-400"></i>
                                                    <span>@item.Rating</span>
                                                    <span class="text-stone-400 font-normal">(@item.ReviewsCount)</span>
                                                </div>
                                            </div>
                                            <h3 class="text-lg font-bold tracking-tight">@item.Name</h3>
                                            <p class="text-xs text-stone-500 dark:text-stone-400 line-clamp-2">@item.Description</p>
                                            <div class="flex items-center space-x-1.5 text-xs text-stone-400 pt-1">
                                                <i data-lucide="map-pin" class="w-3.5 h-3.5 text-apple-blue"></i>
                                                <span>@item.Location</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="p-5 pt-0 border-t border-stone-200/50 dark:border-stone-800/50 mt-4 flex items-center justify-between">
                                        <div>
                                            <span class="block text-[10px] text-stone-400 font-medium">AVAILABLE SLOTS</span>
                                            <span class="text-xs font-bold text-apple-green">@item.Slots.Length shifts today</span>
                                        </div>
                                        <button @onclick='() => StartBooking(item)' @onclick:stopPropagation class="px-4 py-2 bg-apple-blue hover:bg-apple-blue-hover text-white text-xs font-semibold rounded-xl shadow-md transition flex items-center space-x-1">
                                            <span>Reserve</span>
                                            <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </section>
        }

        @* VIEW 2: BOOKING ENGINE *@
        @if (View == "booking" && BookingRestaurant is not null)
        {
            <section class="space-y-6">
                <div class="flex items-center justify-between border-b border-stone-200 dark:border-stone-800 pb-4">
                    <button @onclick='() => SwitchView("explore")' class="flex items-center space-x-1.5 text-xs font-semibold text-apple-blue hover:underline">
                        <i data-lucide="chevron-left" class="w-4 h-4"></i>
                        <span>Back to Restaurants</span>
                    </button>
                    <div class="text-center">
                        <h2 class="text-lg font-bold">@BookingRestaurant.Name</h2>
                        <p class="text-xs text-stone-500 dark:text-stone-400">@BookingRestaurant.Location • @BookingRestaurant.Cuisine</p>
                    </div>
                    <div class="w-20"></div>
                </div>

                <div class="max-w-xl mx-auto">
                    <div class="flex items-center justify-between text-xs font-medium text-stone-500 mb-2">
                        <span class="@(BookingStep == 1 ? "text-apple-blue font-bold" : "")">1. Time &amp; Guests</span>
                        <span class="@(BookingStep == 2 ? "text-apple-blue font-bold" : "")">2. Select Table</span>
                        <span class="@(BookingStep == 3 ? "text-apple-blue font-bold" : "")">3. Guest Details</span>
                        <span class="@(BookingStep == 4 ? "text-apple-blue font-bold" : "")">4. Confirmation</span>
                    </div>
                    <div class="w-full bg-stone-200 dark:bg-stone-800 h-1.5 rounded-full overflow-hidden">
                        <div class="bg-apple-blue h-full transition-all duration-300" style="width: @(BookingStep * 25)%"></div>
                    </div>
                </div>

                @if (BookingStep == 1)
                {
                    <div class="max-w-2xl mx-auto bg-[#F8F7F4] dark:bg-stone-900 rounded-3xl p-6 md:p-8 shadow-apple-card border border-stone-200/80 dark:border-stone-800 space-y-6">
                        <h3 class="text-base font-bold flex items-center space-x-2">
                            <i data-lucide="users" class="w-5 h-5 text-apple-blue"></i>
                            <span>Select Party Size &amp; Date</span>
                        </h3>

                        <div>
                            <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-2">Party Size</label>
                            <div class="flex items-center space-x-2 overflow-x-auto pb-2">
                                @for (var i = 1; i <= 8; i++)
                                {
                                    var guests = i;
                                    <button @onclick='() => PartySize = guests' class="px-4 py-2.5 rounded-xl border text-sm font-semibold transition @(PartySize == guests ? "border-apple-blue bg-apple-blue text-white" : "border-stone-300/80 dark:border-stone-700 hover:border-apple-blue")">@guests @(guests == 1 ? "Guest" : "Guests")</button>
                                }
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-2">Select Date</label>
                            <div class="grid grid-cols-3 gap-2 mb-3">
                                @foreach (var shortcut in DateShortcuts)
                                {
                                    <button @onclick='() => SelectDateShortcut(shortcut.Offset)' class="py-2.5 px-3 rounded-xl text-xs font-semibold text-center border @(DateShortcut == shortcut.Offset ? "border-apple-blue bg-apple-blue/10 text-apple-blue" : "border-stone-300/80 dark:border-stone-700 hover:border-apple-blue")">@shortcut.Label</button>
                                }
                            </div>
                            <input type="date" value="@BookingDate" @onchange="e => BookingDate = e.Value?.ToString() ?? string.Empty" class="w-full bg-[#F0EEE9] dark:bg-stone-800 border border-stone-300/80 dark:border-stone-700 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue" />
                        </div>

                        <div>
                            <div class="flex items-center justify-between mb-2">
                                <label class="text-xs font-semibold text-stone-500 uppercase tracking-wider">Available Timeslots</label>
                                <span class="text-xs text-apple-green font-medium flex items-center space-x-1">
                                    <span class="w-1.5 h-1.5 rounded-full bg-apple-green animate-ping"></span>
                                    <span>Real-time availability</span>
                                </span>
                            </div>
                            <div class="grid grid-cols-3 sm:grid-cols-4 gap-2.5">
                                @for (var idx = 0; idx < BookingRestaurant.Slots.Length; idx++)
                                {
                                    var slot = BookingRestaurant.Slots[idx];
                                    <button @onclick='() => TimeSlot = slot' class="py-3 px-3 rounded-xl border text-xs font-bold text-center transition @(TimeSlot == slot ? "border-apple-blue bg-apple-blue text-white" : "border-stone-300/80 dark:border-stone-700 hover:border-apple-blue")">
                                        <div>@slot</div>
                                        <div class="text-[9px] font-normal opacity-80">@(idx % 2 == 0 ? "High Demand" : "3 Tables Left")</div>
                                    </button>
                                }
                            </div>
                        </div>

                        <button @onclick='() => GoToBookingStep(2)' class="w-full py-3.5 bg-apple-blue hover:bg-apple-blue-hover text-white font-semibold rounded-2xl shadow-lg shadow-apple-blue/20 transition flex items-center justify-center space-x-2 text-sm" disabled="@(TimeSlot is null)">
                            <span>Continue to Table Selection</span>
                            <i data-lucide="arrow-right" class="w-4 h-4"></i>
                        </button>
                    </div>
                }

                @if (BookingStep == 2)
                {
                    <div class="max-w-4xl mx-auto space-y-4">
                        <div class="bg-[#F8F7F4] dark:bg-stone-900 rounded-3xl p-6 shadow-apple-card border border-stone-200/80 dark:border-stone-800 space-y-4">
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                                <div>
                                    <h3 class="text-base font-bold flex items-center space-x-2">
                                        <i data-lucide="layout" class="w-5 h-5 text-apple-blue"></i>
                                        <span>Choose Your Table &amp; Dining Zone</span>
                                    </h3>
                                    <p class="text-xs text-stone-500 dark:text-stone-400">Tap an available table on the floorplan map below</p>
                                </div>
                                <div class="flex items-center space-x-3 text-xs">
                                    <span class="flex items-center space-x-1"><span class="w-3 h-3 rounded-full bg-emerald-500"></span> <span>Available</span></span>
                                    <span class="flex items-center space-x-1"><span class="w-3 h-3 rounded-full bg-apple-blue"></span> <span>Selected</span></span>
                                    <span class="flex items-center space-x-1"><span class="w-3 h-3 rounded-full bg-stone-400"></span> <span>Reserved</span></span>
                                </div>
                            </div>

                            <div class="relative w-full border border-stone-300/70 dark:border-stone-800 rounded-2xl bg-[#EFECE6] dark:bg-stone-950 p-4 overflow-hidden min-h-[340px] flex items-center justify-center">
                                <svg viewBox="0 0 800 450" class="w-full h-auto max-h-[420px] select-none">
                                    <rect x="20" y="20" width="460" height="410" rx="20" fill="none" stroke="#E5E7EB" stroke-dasharray="4" stroke-width="2"/>
                                    <text x="40" y="45" font-size="12" font-weight="bold" fill="#9CA3AF">MAIN DINING ROOM</text>

                                    <rect x="510" y="20" width="270" height="410" rx="20" fill="none" stroke="#E5E7EB" stroke-dasharray="4" stroke-width="2"/>
                                    <text x="530" y="45" font-size="12" font-weight="bold" fill="#9CA3AF">OCEAN TERRACE PATIO</text>

                                    <g class="table-node @(IsSelectedTable("Table 01") ? "selected" : "")" @onclick='() => SelectFloorTable(FloorTables[0])'>
                                        <circle cx="100" cy="120" r="35" fill="#34C759" fill-opacity="0.2" stroke="#34C759" stroke-width="3"/>
                                        <text x="100" y="124" text-anchor="middle" font-size="12" font-weight="bold" fill="#1F2937">T-01</text>
                                        <text x="100" y="170" text-anchor="middle" font-size="10" fill="#6B7280">4 Seats</text>
                                    </g>

                                    <g class="table-node occupied">
                                        <circle cx="240" cy="120" r="35" fill="#9CA3AF" fill-opacity="0.3" stroke="#9CA3AF" stroke-width="2"/>
                                        <text x="240" y="124" text-anchor="middle" font-size="12" font-weight="bold" fill="#6B7280">T-02</text>
                                        <text x="240" y="170" text-anchor="middle" font-size="10" fill="#9CA3AF">Reserved</text>
                                    </g>

                                    <g class="table-node @(IsSelectedTable("Table 04") ? "selected" : "")" @onclick='() => SelectFloorTable(FloorTables[1])'>
                                        <rect x="340" y="85" width="90" height="70" rx="12" fill="#34C759" fill-opacity="0.2" stroke="#34C759" stroke-width="3"/>
                                        <text x="385" y="125" text-anchor="middle" font-size="12" font-weight="bold" fill="#1F2937">Table 04</text>
                                        <text x="385" y="175" text-anchor="middle" font-size="10" fill="#6B7280">Booth (4-6)</text>
                                    </g>

                                    <g class="table-node @(IsSelectedTable("Chef Counter 12") ? "selected" : "")" @onclick='() => SelectFloorTable(FloorTables[2])'>
                                        <rect x="80" y="280" width="140" height="50" rx="10" fill="#34C759" fill-opacity="0.2" stroke="#34C759" stroke-width="3"/>
                                        <text x="150" y="310" text-anchor="middle" font-size="12" font-weight="bold" fill="#1F2937">Chef's Counter</text>
                                    </g>

                                    <g class="table-node @(IsSelectedTable("Patio P1") ? "selected" : "")" @onclick='() => SelectFloorTable(FloorTables[3])'>
                                        <circle cx="600" cy="140" r="30" fill="#34C759" fill-opacity="0.2" stroke="#34C759" stroke-width="3"/>
                                        <text x="600" y="144" text-anchor="middle" font-size="11" font-weight="bold" fill="#1F2937">Patio P1</text>
                                    </g>

                                    <g class="table-node @(IsSelectedTable("Patio P2") ? "selected" : "")" @onclick='() => SelectFloorTable(FloorTables[4])'>
                                        <circle cx="700" cy="260" r="38" fill="#34C759" fill-opacity="0.2" stroke="#34C759" stroke-width="3"/>
                                        <text x="700" y="264" text-anchor="middle" font-size="12" font-weight="bold" fill="#1F2937">Patio P2</text>
                                    </g>
                                </svg>
                            </div>

                            <div class="bg-apple-blue/5 border border-apple-blue/20 rounded-2xl p-4 flex items-center justify-between">
                                <div class="flex items-center space-x-3">
                                    <div class="w-10 h-10 rounded-xl bg-apple-blue text-white flex items-center justify-center font-bold text-base">
                                        <i data-lucide="armchair" class="w-5 h-5"></i>
                                    </div>
                                    <div>
                                        <h4 class="text-sm font-bold">@(SelectedTable?.Name ?? "No Table Selected")</h4>
                                        <p class="text-xs text-stone-500">@(SelectedTable is null ? "Select a highlighted table from the dining floor plan above" : $"{SelectedTable.Description} ({SelectedTable.Capacity} seats max)")</p>
                                    </div>
                                </div>
                                <span class="px-2.5 py-1 rounded-full text-xs font-semibold @(SelectedTable is null ? "bg-stone-200 dark:bg-stone-800 text-stone-600 dark:text-stone-300" : "bg-apple-green text-white")">@(SelectedTable is null ? "Required" : "Selected")</span>
                            </div>

                            <div class="flex items-center justify-between pt-2">
                                <button @onclick='() => GoToBookingStep(1)' class="px-5 py-2.5 border border-stone-300/80 dark:border-stone-700 text-xs font-semibold rounded-xl hover:bg-stone-200/50 dark:hover:bg-stone-800 transition">Back</button>
                                <button @onclick='() => GoToBookingStep(3)' disabled="@(SelectedTable is null)" class="px-6 py-2.5 bg-apple-blue disabled:opacity-50 hover:bg-apple-blue-hover text-white text-xs font-semibold rounded-xl shadow-md transition flex items-center space-x-1.5">
                                    <span>Proceed to Guest Details</span>
                                    <i data-lucide="chevron-right" class="w-4 h-4"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                }

                @if (BookingStep == 3)
                {
                    <div class="max-w-2xl mx-auto bg-[#F8F7F4] dark:bg-stone-900 rounded-3xl p-6 md:p-8 shadow-apple-card border border-stone-200/80 dark:border-stone-800 space-y-6">
                        <h3 class="text-base font-bold flex items-center space-x-2">
                            <i data-lucide="user-check" class="w-5 h-5 text-apple-blue"></i>
                            <span>Contact Information &amp; Dietary Notes</span>
                        </h3>

                        <form @onsubmit="SubmitGuestDetails" @onsubmit:preventDefault class="space-y-4">
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Full Name *</label>
                                    <input type="text" @bind="GuestName" @bind:event="oninput" required placeholder="e.g. Johnathan Vance" class="w-full bg-[#F0EEE9] dark:bg-stone-800 border border-stone-300/80 dark:border-stone-700 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue" />
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Mobile Phone *</label>
                                    <input type="tel" @bind="GuestPhone" @bind:event="oninput" required placeholder="+27 82 123 4567" class="w-full bg-[#F0EEE9] dark:bg-stone-800 border border-stone-300/80 dark:border-stone-700 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue" />
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Email Address *</label>
                                <input type="email" @bind="GuestEmail" @bind:event="oninput" required placeholder="johnathan@example.com" class="w-full bg-[#F0EEE9] dark:bg-stone-800 border border-stone-300/80 dark:border-stone-700 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue" />
                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-2">Special Occasion</label>
                                <div class="flex flex-wrap gap-2">
                                    @foreach (var occasion in Occasions)
                                    {
                                        var value = occasion;
                                        <button type="button" @onclick='() => ToggleOccasion(value)' class="px-3 py-1.5 rounded-full border text-xs font-medium hover:border-apple-blue transition @(Occasion == value ? "bg-apple-blue text-white border-apple-blue" : "border-stone-300/80 dark:border-stone-700")">@value</button>
                                    }
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-2">Dietary Requirements</label>
                                <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                                    @foreach (var diet in DietaryOptions)
                                    {
                                        var value = diet;
                                        <label class="flex items-center space-x-2 text-xs font-medium p-2 border border-stone-300/80 dark:border-stone-700 rounded-xl cursor-pointer hover:bg-stone-200/50 dark:hover:bg-stone-800">
                                            <input type="checkbox" checked="@Dietary.Contains(value)" @onchange="() => ToggleDietary(value)" class="rounded text-apple-blue focus:ring-apple-blue" />
                                            <span>@value</span>
                                        </label>
                                    }
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Special Requests / Notes</label>
                                <textarea @bind="GuestNotes" @bind:event="oninput" rows="2" placeholder="High chair needed, quiet area preference, champagne on arrival..." class="w-full bg-[#F0EEE9] dark:bg-stone-800 border border-stone-300/80 dark:border-stone-700 rounded-xl p-3 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue"></textarea>
                            </div>

                            <div class="flex items-center justify-between pt-4">
                                <button type="button" @onclick='() => GoToBookingStep(2)' class="px-5 py-2.5 border border-stone-300/80 dark:border-stone-700 text-xs font-semibold rounded-xl hover:bg-stone-200/50 dark:hover:bg-stone-800 transition">Back</button>
                                <button type="submit" class="px-6 py-2.5 bg-apple-blue hover:bg-apple-blue-hover text-white text-xs font-semibold rounded-xl shadow-md transition flex items-center space-x-1.5">
                                    <span>Review Booking</span>
                                    <i data-lucide="chevron-right" class="w-4 h-4"></i>
                                </button>
                            </div>
                        </form>
                    </div>
                }

                @if (BookingStep == 4)
                {
                    <div class="max-w-xl mx-auto space-y-6">
                        @if (!BookingConfirmed)
                        {
                            <div class="bg-[#F8F7F4] dark:bg-stone-900 rounded-3xl p-6 md:p-8 shadow-apple-card border border-stone-200/80 dark:border-stone-800 space-y-6">
                                <div class="text-center space-y-2">
                                    <div class="w-12 h-12 bg-apple-blue/10 text-apple-blue rounded-2xl mx-auto flex items-center justify-center">
                                        <i data-lucide="shield-check" class="w-6 h-6"></i>
                                    </div>
                                    <h3 class="text-xl font-bold">Review Reservation Details</h3>
                                    <p class="text-xs text-stone-500">Please confirm your reservation parameters below</p>
                                </div>

                                <div class="bg-[#F0EEE9] dark:bg-stone-800/50 rounded-2xl p-4 space-y-3 text-sm border border-stone-200/60 dark:border-stone-800">
                                    <div class="flex justify-between pb-2 border-b border-stone-200 dark:border-stone-700">
                                        <span class="text-stone-500 text-xs">Restaurant</span>
                                        <span class="font-bold text-xs">@BookingRestaurant.Name</span>
                                    </div>
                                    <div class="flex justify-between pb-2 border-b border-stone-200 dark:border-stone-700">
                                        <span class="text-stone-500 text-xs">Date &amp; Time</span>
                                        <span class="font-semibold text-xs">@BookingDate at @TimeSlot</span>
                                    </div>
                                    <div class="flex justify-between pb-2 border-b border-stone-200 dark:border-stone-700">
                                        <span class="text-stone-500 text-xs">Party Size</span>
                                        <span class="font-semibold text-xs">@PartySize Guests</span>
                                    </div>
                                    <div class="flex justify-between pb-2 border-b border-stone-200 dark:border-stone-700">
                                        <span class="text-stone-500 text-xs">Seating Area / Table</span>
                                        <span class="font-semibold text-apple-blue text-xs">@(SelectedTable?.Name ?? "Host Selected")</span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span class="text-stone-500 text-xs">Guest</span>
                                        <span class="font-semibold text-xs">@GuestName</span>
                                    </div>
                                </div>

                                <div class="flex items-start space-x-2 text-xs text-stone-500 bg-amber-50 dark:bg-amber-950/30 p-3 rounded-xl border border-amber-200 dark:border-amber-900/50">
                                    <i data-lucide="info" class="w-4 h-4 text-amber-600 flex-shrink-0 mt-0.5"></i>
                                    <span>15-minute grace period applied. Free cancellation up to 2 hours prior to reservation time.</span>
                                </div>

                                <div class="space-y-2">
                                    <button @onclick="ConfirmBooking" class="w-full py-3.5 bg-black dark:bg-white text-white dark:text-black font-semibold rounded-2xl shadow-xl hover:opacity-90 transition flex items-center justify-center space-x-2 text-sm">
                                        <i data-lucide="apple" class="w-5 h-5 mb-0.5"></i>
                                        <span>Confirm with Apple Pay / Instant Reserve</span>
                                    </button>
                                    <button @onclick='() => GoToBookingStep(3)' class="w-full py-2.5 text-xs text-stone-500 font-medium hover:underline">Modify Information</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="bg-[#F8F7F4] dark:bg-stone-900 rounded-3xl p-6 md:p-8 shadow-2xl border border-apple-green/30 text-center space-y-6">
                                <div class="space-y-2">
                                    <div class="w-16 h-16 bg-apple-green text-white rounded-full mx-auto flex items-center justify-center shadow-lg shadow-apple-green/30">
                                        <i data-lucide="check" class="w-8 h-8"></i>
                                    </div>
                                    <p class="text-xs font-bold uppercase tracking-widest text-apple-green">Reservation Confirmed</p>
                                    <h3 class="text-2xl font-black mt-1">We look forward to serving you!</h3>
                                    <p class="text-xs text-stone-500 mt-1">Confirmation code sent to your email &amp; mobile</p>
                                </div>

                                <div class="bg-[#F0EEE9] dark:bg-stone-800 p-6 rounded-2xl border border-stone-200/80 dark:border-stone-700 flex flex-col items-center space-y-3">
                                    <span class="text-xs font-semibold text-stone-400">BOOKING REFERENCE CODE</span>
                                    <span class="font-mono text-2xl font-extrabold text-apple-blue tracking-wider">@ConfirmationCode</span>
                                    <div class="w-32 h-32 bg-[#F8F7F4] p-2 rounded-xl border border-stone-300 flex items-center justify-center">
                                        <svg class="w-full h-full text-black" viewBox="0 0 100 100">
                                            <path fill="currentColor" d="M10 10h30v30H10zM50 10h40v10H50zM60 30h30v20H60zM10 50h20v40H10zM40 60h20v30H40zM70 70h20v20H70z"/>
                                        </svg>
                                    </div>
                                    <span class="text-[10px] text-stone-400">Present this QR code upon arrival at the host stand</span>
                                </div>

                                <div class="flex flex-col sm:flex-row gap-2">
                                    <button @onclick="SaveToAppleWallet" class="flex-1 py-3 bg-black dark:bg-stone-800 text-white font-medium text-xs rounded-xl flex items-center justify-center space-x-2 border border-stone-700">
                                        <i data-lucide="wallet" class="w-4 h-4"></i>
                                        <span>Add to Apple Wallet</span>
                                    </button>
                                    <button @onclick="ViewMyBookings" class="flex-1 py-3 bg-apple-blue text-white font-medium text-xs rounded-xl hover:bg-apple-blue-hover transition">View My Bookings</button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>
        }

        @* VIEW 3: MY BOOKINGS *@
        @if (View == "bookings")
        {
            <section class="space-y-6">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-stone-200 dark:border-stone-800 pb-4">
                    <div>
                        <h1 class="text-2xl font-bold tracking-tight">My Reservations</h1>
                        <p class="text-xs text-stone-500">Manage upcoming and past restaurant table bookings</p>
                    </div>
                    <div class="flex items-center space-x-2">
                        <input type="text" @bind="LookupCode" placeholder="Enter Ref Code (#TBL-...) or Phone" class="bg-[#F8F7F4] dark:bg-stone-900 border border-stone-300/80 dark:border-stone-800 rounded-xl px-3 py-2 text-xs w-56 focus:outline-none focus:ring-2 focus:ring-apple-blue" />
                        <button @onclick="LookupBooking" class="px-3 py-2 bg-apple-blue text-white rounded-xl text-xs font-semibold hover:bg-apple-blue-hover transition">Lookup</button>
                    </div>
                </div>

                <div class="flex justify-center">
                    <div class="sf-segmented flex space-x-1 p-1 max-w-xs w-full">
                        <button @onclick='() => SetBookingsTab("active")' class="@(BookingsTab == "active" ? "active" : "text-stone-500") flex-1 py-1.5 text-xs font-semibold rounded-md">Active (@Bookings.Count(b => b.Status == "Active"))</button>
                        <button @onclick='() => SetBookingsTab("past")' class="@(BookingsTab == "past" ? "active" : "text-stone-500") flex-1 py-1.5 text-xs font-semibold rounded-md">History (@Bookings.Count(b => b.Status == "Past"))</button>
                    </div>
                </div>

                <div class="max-w-3xl mx-auto space-y-4">
                    @if (!VisibleBookings.Any())
                    {
                        <div class="text-center py-12 space-y-3">
                            <i data-lucide="calendar-x" class="w-10 h-10 text-stone-400 mx-auto"></i>
                            <p class="text-sm font-semibold text-stone-500">No @BookingsTab reservations found</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in VisibleBookings.ToList())
                        {
                            var booking = item;
                            <div class="sf-glass rounded-2xl p-5 shadow-apple-card border border-stone-200/80 dark:border-stone-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                                <div class="space-y-1">
                                    <div class="flex items-center space-x-2">
                                        <span class="font-mono text-xs font-bold text-apple-blue">@booking.Ref</span>
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold @(booking.Status == "Active" ? "bg-apple-green/20 text-apple-green" : "bg-stone-200 text-stone-600")">@booking.Status</span>
                                    </div>
                                    <h3 class="text-base font-bold">@booking.RestaurantName</h3>
                                    <div class="flex items-center space-x-3 text-xs text-stone-500">
                                        <span><i data-lucide="calendar" class="w-3.5 h-3.5 inline mr-1"></i>@booking.Date</span>
                                        <span><i data-lucide="clock" class="w-3.5 h-3.5 inline mr-1"></i>@booking.Time</span>
                                        <span><i data-lucide="users" class="w-3.5 h-3.5 inline mr-1"></i>@booking.Guests Guests</span>
                                    </div>
                                    <div class="text-xs text-apple-blue font-medium">@booking.Table</div>
                                </div>

                                <div class="flex items-center space-x-2">
                                    @if (booking.Status == "Active")
                                    {
                                        <button @onclick='() => CancelBooking(booking)' class="px-3 py-1.5 border border-apple-red/30 text-apple-red hover:bg-apple-red/10 rounded-xl text-xs font-semibold transition">Cancel</button>
                                        <button @onclick="ModifyBooking" class="px-3 py-1.5 bg-[#F0EEE9] dark:bg-stone-800 rounded-xl text-xs font-semibold hover:bg-stone-200 transition">Modify</button>
                                    }
                                    else
                                    {
                                        <button @onclick='() => RebookRestaurant(booking.RestaurantId)' class="px-3 py-1.5 bg-apple-blue text-white rounded-xl text-xs font-semibold hover:bg-apple-blue-hover transition">Re-book Table</button>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </section>
        }

        @* VIEW 4: LIVE OPERATIONS *@
        @if (View == "ops")
        {
            <section class="space-y-6">
                <div class="bg-[#F8F7F4] dark:bg-stone-900 rounded-3xl p-6 shadow-apple-card border border-stone-200/80 dark:border-stone-800 space-y-4">
                    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                        <div>
                            <div class="flex items-center space-x-2">
                                <span class="w-2.5 h-2.5 rounded-full bg-apple-green animate-ping"></span>
                                <h1 class="text-xl font-bold">Floor Operations Console</h1>
                            </div>
                            <p class="text-xs text-stone-500">Live shift capacity, table statuses, and walk-in allocation</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
                        <div class="bg-[#F0EEE9] dark:bg-stone-800/60 p-3.5 rounded-2xl border border-stone-200/60 dark:border-stone-800">
                            <span class="text-[10px] font-bold text-stone-400 uppercase tracking-wider">Total Shift Covers</span>
                            <div class="text-2xl font-black mt-1">42 / 60</div>
                            <span class="text-[10px] text-apple-green font-semibold">70% Capacity</span>
                        </div>
                        <div class="bg-[#F0EEE9] dark:bg-stone-800/60 p-3.5 rounded-2xl border border-stone-200/60 dark:border-stone-800">
                            <span class="text-[10px] font-bold text-stone-400 uppercase tracking-wider">Active Tables</span>
                            <div class="text-2xl font-black mt-1 text-apple-blue">8 Occupied</div>
                            <span class="text-[10px] text-stone-500">4 Seated, 4 Reserved</span>
                        </div>
                        <div class="bg-[#F0EEE9] dark:bg-stone-800/60 p-3.5 rounded-2xl border border-stone-200/60 dark:border-stone-800">
                            <span class="text-[10px] font-bold text-stone-400 uppercase tracking-wider">Upcoming Arrivals</span>
                            <div class="text-2xl font-black mt-1 text-apple-orange">5 Parties</div>
                            <span class="text-[10px] text-stone-500">Next at 19:45</span>
                        </div>
                        <div class="bg-[#F0EEE9] dark:bg-stone-800/60 p-3.5 rounded-2xl border border-stone-200/60 dark:border-stone-800">
                            <span class="text-[10px] font-bold text-stone-400 uppercase tracking-wider">VIP Guests Tonight</span>
                            <div class="text-2xl font-black mt-1 text-apple-purple">3 VIPs</div>
                            <span class="text-[10px] text-apple-purple font-semibold">Special Dietary Notes</span>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <div class="lg:col-span-2 bg-[#F8F7F4] dark:bg-stone-900 rounded-3xl p-6 shadow-apple-card border border-stone-200/80 dark:border-stone-800 space-y-4">
                        <div class="flex items-center justify-between">
                            <h3 class="text-sm font-bold flex items-center space-x-2">
                                <i data-lucide="map" class="w-4 h-4 text-apple-blue"></i>
                                <span>Floor Status Manager</span>
                            </h3>
                            <span class="text-xs text-stone-400">Click table to change status</span>
                        </div>

                        <div class="relative border border-stone-300/70 dark:border-stone-800 rounded-2xl bg-[#EFECE6] dark:bg-stone-950 p-4 min-h-[320px]">
                            <svg viewBox="0 0 800 450" class="w-full h-auto max-h-[400px]">
                                <rect x="20" y="20" width="760" height="410" rx="20" fill="none" stroke="#E5E7EB" stroke-dasharray="4" stroke-width="2"/>
                                <text x="40" y="45" font-size="12" font-weight="bold" fill="#9CA3AF">LIVE FLOOR MANAGEMENT MAP</text>

                                <g @onclick="ToggleOpsTableStatus" class="cursor-pointer">
                                    <circle cx="120" cy="140" r="35" fill="#34C759" fill-opacity="0.2" stroke="#34C759" stroke-width="3"/>
                                    <text x="120" y="144" text-anchor="middle" font-size="12" font-weight="bold" fill="#1F2937">T-01</text>
                                    <text x="120" y="190" text-anchor="middle" font-size="10" fill="#34C759" font-weight="bold">AVAILABLE</text>
                                </g>

                                <g @onclick="ToggleOpsTableStatus" class="cursor-pointer">
                                    <rect x="260" y="105" width="90" height="70" rx="12" fill="#FF9500" fill-opacity="0.2" stroke="#FF9500" stroke-width="3"/>
                                    <text x="305" y="145" text-anchor="middle" font-size="12" font-weight="bold" fill="#1F2937">T-04</text>
                                    <text x="305" y="195" text-anchor="middle" font-size="10" fill="#FF9500" font-weight="bold">RESERVED (19:30)</text>
                                </g>

                                <g @onclick="ToggleOpsTableStatus" class="cursor-pointer">
                                    <circle cx="500" cy="140" r="35" fill="#FF3B30" fill-opacity="0.2" stroke="#FF3B30" stroke-width="3"/>
                                    <text x="500" y="144" text-anchor="middle" font-size="12" font-weight="bold" fill="#1F2937">T-08</text>
                                    <text x="500" y="190" text-anchor="middle" font-size="10" fill="#FF3B30" font-weight="bold">SEATED</text>
                                </g>
                            </svg>
                        </div>

                        <div class="flex flex-wrap items-center justify-between gap-2 text-xs pt-2">
                            <div class="flex items-center space-x-3">
                                <span class="flex items-center space-x-1"><span class="w-3 h-3 rounded-full bg-emerald-500"></span> <span>Available</span></span>
                                <span class="flex items-center space-x-1"><span class="w-3 h-3 rounded-full bg-amber-500"></span> <span>Reserved</span></span>
                                <span class="flex items-center space-x-1"><span class="w-3 h-3 rounded-full bg-rose-500"></span> <span>Seated/Occupied</span></span>
                                <span class="flex items-center space-x-1"><span class="w-3 h-3 rounded-full bg-stone-400"></span> <span>Cleaning</span></span>
                            </div>
                            <button @onclick="BlockTable" class="px-3 py-1.5 bg-[#F0EEE9] dark:bg-stone-800 rounded-lg font-semibold text-stone-700 dark:text-stone-300 hover:bg-stone-200">+ Manual Table Block</button>
                        </div>
                    </div>

                    <div class="bg-[#F8F7F4] dark:bg-stone-900 rounded-3xl p-6 shadow-apple-card border border-stone-200/80 dark:border-stone-800 space-y-4">
                        <h3 class="text-sm font-bold flex items-center space-x-2 border-b border-stone-200/80 dark:border-stone-800 pb-3">
                            <i data-lucide="clock" class="w-4 h-4 text-apple-blue"></i>
                            <span>Shift Arrivals Stream</span>
                        </h3>

                        <div class="space-y-3 max-h-[380px] overflow-y-auto pr-1">
                            @foreach (var arrival in Arrivals)
                            {
                                <div class="p-3 bg-[#F0EEE9] dark:bg-stone-800/60 rounded-xl border-l-4 @(arrival.Seated ? "border-apple-green" : "border-apple-orange") flex items-center justify-between">
                                    <div>
                                        <div class="flex items-center space-x-2">
                                            <span class="text-xs font-bold">@arrival.Time</span>
                                            <span class="text-xs font-semibold">@arrival.Name</span>
                                        </div>
                                        <span class="text-[10px] text-stone-500">@arrival.Detail</span>
                                    </div>
                                    @if (arrival.Seated)
                                    {
                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-apple-green/20 text-apple-green">Seated</span>
                                    }
                                    else
                                    {
                                        <button @onclick='() => SeatGuest(arrival)' class="px-2 py-1 rounded text-[10px] font-bold bg-apple-blue text-white hover:opacity-90">Seat Guest</button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </section>
        }
    </main>

    @if (ActiveModalRestaurant is { } modal)
    {
        <div class="fixed inset-0 z-50 bg-black/40 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto">
            <div class="bg-[#F8F7F4] dark:bg-stone-900 w-full max-w-4xl rounded-3xl shadow-2xl border border-stone-200 dark:border-stone-800 overflow-hidden my-auto max-h-[92vh] flex flex-col">
                <div class="relative h-64 sm:h-72 w-full flex-shrink-0">
                    <img src="@modal.Image" alt="Restaurant" class="w-full h-full object-cover">
                    <div class="absolute inset-0 bg-gradient-to-t from-stone-950/90 via-black/30 to-black/20"></div>

                    <button @onclick="CloseRestaurant" class="absolute top-4 right-4 w-9 h-9 rounded-full bg-black/50 text-white backdrop-blur-md flex items-center justify-center hover:bg-black/70 transition">
                        <i data-lucide="x" class="w-5 h-5"></i>
                    </button>

                    <div class="absolute top-4 left-4 flex space-x-2">
                        <span class="bg-black/60 backdrop-blur-md text-white text-[11px] font-bold px-3 py-1 rounded-full border border-white/20">@modal.Badge</span>
                        <button @onclick='() => ToggleFavorite(modal)' class="bg-black/60 backdrop-blur-md text-white text-xs font-semibold px-3 py-1 rounded-full border border-white/20 flex items-center space-x-1 hover:bg-black/80">
                            <i data-lucide="heart" class="w-3.5 h-3.5 @(Favorites.Contains(modal.Id) ? "text-apple-red fill-apple-red" : "text-apple-red")"></i>
                            <span>@(Favorites.Contains(modal.Id) ? "Saved" : "Save")</span>
                        </button>
                    </div>

                    <div class="absolute bottom-4 left-6 right-6 text-white space-y-1">
                        <div class="flex items-center space-x-2 text-xs font-semibold text-apple-blue">
                            <span class="bg-apple-blue/20 backdrop-blur-md text-white px-2.5 py-0.5 rounded-full border border-apple-blue/30">@modal.Cuisine</span>
                            <span class="text-stone-300">@modal.Price</span>
                            <span>•</span>
                            <div class="flex items-center space-x-1 text-amber-400 font-bold">
                                <i data-lucide="star" class="w-4 h-4 fill-amber-400"></i>
                                <span>@modal.Rating</span>
                                <span class="text-stone-300 font-normal text-xs">(@modal.ReviewsCount reviews)</span>
                            </div>
                        </div>
                        <h2 class="text-2xl sm:text-3xl font-black tracking-tight">@modal.Name</h2>
                        <p class="text-xs sm:text-sm text-stone-300 flex items-center space-x-1">
                            <i data-lucide="map-pin" class="w-3.5 h-3.5 text-apple-blue"></i>
                            <span>@modal.Location</span>
                        </p>
                    </div>
                </div>

                <div class="px-6 pt-4 border-b border-stone-200 dark:border-stone-800 bg-[#F0EEE9]/60 dark:bg-stone-900 flex-shrink-0">
                    <div class="flex space-x-4 border-b border-transparent">
                        <button @onclick='() => SwitchModalTab("overview")' class="@(ModalTab == "overview" ? "border-apple-blue text-apple-blue" : "border-transparent text-stone-500") border-b-2 pb-3 text-xs font-bold transition">Overview &amp; Menu</button>
                        <button @onclick='() => SwitchModalTab("map")' class="@(ModalTab == "map" ? "border-apple-blue text-apple-blue" : "border-transparent text-stone-500") border-b-2 pb-3 text-xs font-bold hover:text-stone-900 dark:hover:text-white transition">Location &amp; Directions</button>
                        <button @onclick='() => SwitchModalTab("reviews")' class="@(ModalTab == "reviews" ? "border-apple-blue text-apple-blue" : "border-transparent text-stone-500") border-b-2 pb-3 text-xs font-bold hover:text-stone-900 dark:hover:text-white transition">Reviews &amp; Community</button>
                    </div>
                </div>

                <div class="p-6 overflow-y-auto space-y-6 flex-grow">
                    @if (ModalTab == "overview")
                    {
                        <div class="space-y-6">
                            <div class="space-y-2">
                                <h3 class="text-sm font-bold uppercase tracking-wider text-stone-400">About Venue</h3>
                                <p class="text-sm leading-relaxed text-stone-700 dark:text-stone-300">@modal.Description</p>
                            </div>

                            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                                <div class="bg-[#F0EEE9] dark:bg-stone-800/60 p-3 rounded-2xl border border-stone-200 dark:border-stone-800">
                                    <span class="text-[10px] font-bold text-stone-400 uppercase">Dress Code</span>
                                    <p class="text-xs font-bold mt-0.5">@modal.DressCode</p>
                                </div>
                                <div class="bg-[#F0EEE9] dark:bg-stone-800/60 p-3 rounded-2xl border border-stone-200 dark:border-stone-800">
                                    <span class="text-[10px] font-bold text-stone-400 uppercase">Valet &amp; Parking</span>
                                    <p class="text-xs font-bold mt-0.5">@modal.Parking</p>
                                </div>
                                <div class="bg-[#F0EEE9] dark:bg-stone-800/60 p-3 rounded-2xl border border-stone-200 dark:border-stone-800">
                                    <span class="text-[10px] font-bold text-stone-400 uppercase">Corkage Fee</span>
                                    <p class="text-xs font-bold mt-0.5">@modal.Corkage</p>
                                </div>
                                <div class="bg-[#F0EEE9] dark:bg-stone-800/60 p-3 rounded-2xl border border-stone-200 dark:border-stone-800">
                                    <span class="text-[10px] font-bold text-stone-400 uppercase">Cancellation</span>
                                    <p class="text-xs font-bold mt-0.5 text-apple-green">2 Hours Free</p>
                                </div>
                            </div>

                            <div class="space-y-3">
                                <h3 class="text-sm font-bold uppercase tracking-wider text-stone-400 flex items-center space-x-1.5">
                                    <i data-lucide="utensils-crossed" class="w-4 h-4 text-apple-blue"></i>
                                    <span>Chef's Signature Menu Highlights</span>
                                </h3>
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                    @foreach (var dish in modal.Menu)
                                    {
                                        <div class="p-3 bg-[#F0EEE9] dark:bg-stone-800/60 rounded-xl border border-stone-200 dark:border-stone-800 flex justify-between items-center">
                                            <div>
                                                <span class="text-xs font-bold block">@dish.Name</span>
                                                <span class="text-[10px] text-apple-blue font-semibold px-2 py-0.5 bg-apple-blue/10 rounded-full inline-block mt-0.5">@dish.Tag</span>
                                            </div>
                                            <span class="text-xs font-extrabold text-stone-900 dark:text-white">@dish.Price</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    else if (ModalTab == "map")
                    {
                        <div class="space-y-6">
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-[#F0EEE9] dark:bg-stone-800/60 p-4 rounded-2xl border border-stone-200 dark:border-stone-800">
                                <div class="space-y-1">
                                    <span class="text-[10px] font-bold uppercase tracking-wider text-apple-blue">Address &amp; Location</span>
                                    <h4 class="text-sm font-bold">@modal.Address</h4>
                                    <p class="text-xs text-stone-500">Cross streets: @modal.CrossStreet</p>
                                </div>
                                <a href="@MapsUrl(modal)" target="_blank" class="px-5 py-3 bg-apple-blue hover:bg-apple-blue-hover text-white text-xs font-bold rounded-xl shadow-lg shadow-apple-blue/20 flex items-center justify-center space-x-2 transition whitespace-nowrap">
                                    <i data-lucide="navigation" class="w-4 h-4"></i>
                                    <span>Get Directions in Google Maps</span>
                                </a>
                            </div>

                            <div class="relative w-full h-64 sm:h-80 rounded-2xl border border-stone-300 dark:border-stone-800 overflow-hidden bg-stone-200 dark:bg-stone-950 flex items-center justify-center">
                                <div class="absolute inset-0 bg-[radial-gradient(#d1d5db_1px,transparent_1px)] dark:bg-[radial-gradient(#374151_1px,transparent_1px)] [background-size:20px_20px] opacity-60"></div>
                                <svg class="absolute inset-0 w-full h-full text-stone-300 dark:text-stone-800 opacity-70" viewBox="0 0 400 200">
                                    <path d="M 0 50 Q 150 120 400 40" stroke="currentColor" stroke-width="12" fill="none" />
                                    <path d="M 200 0 L 200 200" stroke="currentColor" stroke-width="16" fill="none" />
                                </svg>
                                <div class="relative z-10 text-center space-y-1 animate-bounce">
                                    <div class="w-12 h-12 bg-apple-blue text-white rounded-full flex items-center justify-center mx-auto shadow-2xl ring-4 ring-white dark:ring-stone-900">
                                        <i data-lucide="utensils" class="w-6 h-6"></i>
                                    </div>
                                    <span class="inline-block bg-black/80 text-white font-bold text-xs px-3 py-1 rounded-full shadow-lg backdrop-blur-md">@modal.Name</span>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="space-y-6">
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 bg-[#F0EEE9] dark:bg-stone-800/60 p-5 rounded-2xl border border-stone-200 dark:border-stone-800">
                                <div class="text-center md:border-r border-stone-200 dark:border-stone-700 pr-4 flex flex-col justify-center">
                                    <span class="text-5xl font-black text-stone-900 dark:text-white">@modal.Rating</span>
                                    <span class="text-xs text-stone-500 font-medium">Based on @modal.ReviewsCount verified diner reviews</span>
                                </div>
                            </div>

                            <div class="bg-[#F8F7F4] dark:bg-stone-900 border border-stone-300/80 dark:border-stone-800 p-4 rounded-2xl space-y-3">
                                <div class="flex items-center justify-between">
                                    <h4 class="text-xs font-bold uppercase tracking-wider text-apple-blue flex items-center space-x-1">
                                        <i data-lucide="pen-tool" class="w-3.5 h-3.5"></i>
                                        <span>Leave a Verified Guest Review</span>
                                    </h4>
                                    <button @onclick="ToggleReviewForm" class="text-xs text-stone-500 hover:text-black dark:hover:text-white font-semibold underline">Write Review</button>
                                </div>

                                @if (ShowReviewForm)
                                {
                                    <form @onsubmit="SubmitReview" @onsubmit:preventDefault class="space-y-3 pt-2 border-t border-stone-200 dark:border-stone-800">
                                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                            <div>
                                                <label class="block text-[10px] font-semibold text-stone-500 uppercase">Your Name</label>
                                                <input type="text" @bind="NewReviewName" required placeholder="e.g. Sarah M." class="w-full bg-[#F0EEE9] dark:bg-stone-800 border border-stone-300/80 dark:border-stone-700 rounded-xl px-3 py-2 text-xs" />
                                            </div>
                                            <div>
                                                <label class="block text-[10px] font-semibold text-stone-500 uppercase">Rating</label>
                                                <select @bind="NewReviewRating" class="w-full bg-[#F0EEE9] dark:bg-stone-800 border border-stone-300/80 dark:border-stone-700 rounded-xl px-3 py-2 text-xs font-bold text-amber-500">
                                                    <option value="5">★★★★★ (5 - Outstanding)</option>
                                                    <option value="4">★★★★☆ (4 - Very Good)</option>
                                                    <option value="3">★★★☆☆ (3 - Average)</option>
                                                    <option value="2">★★☆☆☆ (2 - Poor)</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div>
                                            <label class="block text-[10px] font-semibold text-stone-500 uppercase">Commentary</label>
                                            <textarea @bind="NewReviewComment" required rows="2" placeholder="Tell us about the dishes, wine pairing, atmosphere..." class="w-full bg-[#F0EEE9] dark:bg-stone-800 border border-stone-300/80 dark:border-stone-700 rounded-xl p-3 text-xs"></textarea>
                                        </div>
                                        <button type="submit" class="w-full py-2.5 bg-apple-blue hover:bg-apple-blue-hover text-white rounded-xl text-xs font-bold transition">Submit Verified Review</button>
                                    </form>
                                }
                            </div>

                            <div class="space-y-3">
                                @foreach (var review in modal.Reviews)
                                {
                                    <div class="p-4 bg-[#F8F7F4] dark:bg-stone-900 border border-stone-200 dark:border-stone-800 rounded-2xl space-y-2">
                                        <div class="flex items-center justify-between">
                                            <div class="flex items-center space-x-2">
                                                <span class="text-xs font-bold">@review.Name</span>
                                                <span class="px-2 py-0.5 rounded-full text-[9px] font-bold bg-apple-green/20 text-apple-green">Verified Diner</span>
                                            </div>
                                            <span class="text-[10px] text-stone-400">@review.Date</span>
                                        </div>
                                        <div class="flex text-amber-400">
                                            @for (var s = 0; s < review.Rating; s++)
                                            {
                                                <i data-lucide="star" class="w-3.5 h-3.5 fill-amber-400"></i>
                                            }
                                        </div>
                                        <p class="text-xs text-stone-600 dark:text-stone-300 leading-relaxed">@review.Comment</p>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="p-4 border-t border-stone-200 dark:border-stone-800 bg-[#F0EEE9]/80 dark:bg-stone-900 flex items-center justify-between flex-shrink-0">
                    <div>
                        <span class="block text-[10px] text-stone-400 uppercase font-bold">Ready to dine?</span>
                        <span class="text-xs font-extrabold">@modal.Name</span>
                    </div>
                    <button @onclick="TriggerBookingFromModal" class="px-6 py-3 bg-apple-blue hover:bg-apple-blue-hover text-white text-xs font-bold rounded-2xl shadow-lg shadow-apple-blue/20 transition flex items-center space-x-1.5">
                        <span>Reserve a Table Now</span>
                        <i data-lucide="chevron-right" class="w-4 h-4"></i>
                    </button>
                </div>
            </div>
        </div>
    }

    @if (LocationModalOpen)
    {
        <div class="fixed inset-0 z-50 bg-black/40 backdrop-blur-sm flex items-center justify-center p-4">
            <div class="bg-[#F8F7F4] dark:bg-stone-900 w-full max-w-sm rounded-3xl p-6 shadow-2xl border border-stone-200 dark:border-stone-800 space-y-4">
                <div class="flex justify-between items-center">
                    <h3 class="text-base font-bold">Select Dining Region</h3>
                    <button @onclick="ToggleLocationModal" class="p-1 text-stone-400 hover:text-black dark:hover:text-white">
                        <i data-lucide="x" class="w-5 h-5"></i>
                    </button>
                </div>
                <div class="space-y-2">
                    @foreach (var region in Locations)
                    {
                        <button @onclick='() => SetLocation(region.Value)' class="w-full text-left px-4 py-3 rounded-xl border border-stone-200/80 dark:border-stone-800 hover:border-apple-blue hover:bg-apple-blue/5 transition text-sm font-semibold flex items-center justify-between">
                            <span>@region.Label</span>
                            @if (Location == region.Value)
                            {
                                <i data-lucide="check" class="w-4 h-4 text-apple-blue"></i>
                            }
                        </button>
                    }
                </div>
            </div>
        </div>
    }

    <footer class="mt-auto border-t border-stone-200 dark:border-stone-800 py-6 text-center text-xs text-stone-500">
        <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
            <p>© 2026 Tableau Reserve Inc. Engineered with Apple Human Interface Guidelines.</p>
            <div class="flex space-x-4 text-stone-400">
                <a href="#" class="hover:underline">Privacy Policy</a>
                <a href="#" class="hover:underline">Terms of Table Service</a>
                <a href="#" class="hover:underline">Concierge Support</a>
            </div>
        </div>
    </footer>
</div>
