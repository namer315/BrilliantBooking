@page "/"
@rendermode InteractiveServer
@inherits HomeBase

<PageTitle>Tableau Reserve — Premium Table Reservations</PageTitle>

<div class="reserve-app @(IsDark ? "dark" : "")">
    <header class="sticky top-0 z-40 sf-glass-nav">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
            <button type="button" @onclick="GoExplore" class="flex items-center gap-2 text-xl font-bold">
                <span class="w-8 h-8 rounded-xl bg-apple-blue flex items-center justify-center text-white"><i data-lucide="utensils" class="w-4 h-4"></i></span>
                <span class="hidden sm:inline">Tableau <span class="text-apple-blue font-normal">Reserve</span></span>
            </button>
            <button type="button" @onclick="(() => LocationModal = true)" class="hidden md:flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-black/5 dark:bg-white/10 text-xs font-medium"><i data-lucide="map-pin" class="w-3.5 h-3.5 text-apple-blue"></i>@Location<i data-lucide="chevron-down" class="w-3 h-3"></i></button>
            <nav class="hidden lg:flex sf-segmented text-xs font-semibold">
                @foreach (var item in NavItems)
                {
                    <button type="button" class="px-4 py-2 rounded-md flex items-center gap-1.5 @(View == item.Value ? "active" : "")" @onclick="(() => SwitchView(item.Value))">
                        @if (item.Value == "ops") { <span class="w-2 h-2 rounded-full bg-apple-green animate-pulse"></span> }
                        <span>@(item.Value == "ops" ? "Live Operations" : item.Label)</span>
                    </button>
                }
            </nav>
            <div class="flex items-center gap-2">
                <button type="button" @onclick="ToggleFavoritesOnly" class="hidden sm:flex items-center gap-1.5 px-3 py-2 rounded-full bg-stone-200/60 dark:bg-stone-800 text-xs font-semibold"><i data-lucide="heart" class="w-3.5 h-3.5 text-apple-red"></i>Saved (@Favorites.Count)</button>
                <button type="button" @onclick="ToggleTheme" class="w-9 h-9 rounded-full hover:bg-black/5 dark:hover:bg-white/10" aria-label="Toggle theme"><i data-lucide="@(IsDark ? "sun" : "moon")" class="w-4 h-4"></i></button>
                <button type="button" @onclick="ToggleMobileMenu" class="lg:hidden w-9 h-9 rounded-xl hover:bg-black/5 dark:hover:bg-white/10" aria-label="Open menu"><i data-lucide="menu" class="w-5 h-5"></i></button>
                <span class="w-9 h-9 rounded-full bg-apple-blue text-white flex items-center justify-center text-xs font-bold">JD</span>
            </div>
        </div>
    </header>

    @if (MobileMenuOpen)
    {
        <div class="lg:hidden border-b border-stone-200 dark:border-stone-800 bg-[#F8F7F4]/95 dark:bg-stone-900/95 backdrop-blur-xl px-4 py-3 space-y-2">
            <button type="button" @onclick="MobileExplore" class="w-full text-left px-3 py-2 rounded-lg text-sm font-medium">Explore Restaurants</button>
            <button type="button" @onclick="MobileBookings" class="w-full text-left px-3 py-2 rounded-lg text-sm font-medium">My Reservations</button>
            <button type="button" @onclick="MobileOps" class="w-full text-left px-3 py-2 rounded-lg text-sm font-medium flex justify-between">Restaurant Staff Operations <span class="text-xs bg-apple-green/20 text-apple-green px-2 py-0.5 rounded-full">Live</span></button>
        </div>
    }

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 min-h-[calc(100vh-9rem)]">
        @if (View == "explore")
        {
            <section class="space-y-8">
                <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-stone-900 via-stone-800 to-black text-white p-8 md:p-12 shadow-2xl">
                    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:16px_16px]"></div>
                    <div class="relative z-10 max-w-2xl space-y-4">
                        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-white/10 text-xs font-semibold tracking-wide backdrop-blur-md border border-white/20"><i data-lucide="sparkles" class="w-3.5 h-3.5 text-apple-orange"></i>Curated Fine Dining Experiences</span>
                        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight">Reserve tables at Cape Town's finest venues.</h1>
                        <p class="text-stone-300 text-sm sm:text-base leading-relaxed">Experience effortless real-time table layout selection, instant confirmations, verified diner reviews, and concierge directions.</p>
                    </div>
                    <div class="relative z-10 mt-8 bg-white/10 backdrop-blur-md rounded-2xl p-4 grid grid-cols-1 md:grid-cols-[1.4fr_1fr_1fr_auto] gap-3">
                        <input @bind="Search" @bind:event="oninput" class="field" placeholder="Search restaurants, cuisines or locations..." aria-label="Search restaurants" />
                        <input type="date" @bind="HeroDate" class="field" aria-label="Dining date" />
                        <select @bind="HeroPartySize" class="field" aria-label="Party size">@for (var i = 1; i <= 8; i++) { <option value="@i">@i guest@(i == 1 ? "" : "s")</option> }</select>
                        <button type="button" @onclick="SearchClick" class="px-5 py-3 rounded-xl bg-apple-blue text-white font-bold text-sm"><i data-lucide="search" class="w-4 h-4 inline mr-1"></i>Search</button>
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row gap-3">
                    <select @bind="Cuisine" class="field" aria-label="Cuisine filter"><option value="all">All Cuisines</option><option>Seafood</option><option>French</option><option>Japanese</option><option>Italian</option><option>Farm-to-Table</option></select>
                    <select @bind="Price" class="field" aria-label="Price filter"><option value="all">All Prices</option><option>$$</option><option>$$$</option><option>$$$$</option></select>
                </div>
                <div class="flex gap-2 overflow-x-auto pb-1">@foreach (var chip in Categories) { <button type="button" @onclick="(() => SetCategory(chip.Value))" class="@(Category == chip.Value ? "bg-apple-blue text-white border-apple-blue" : "border-stone-300/60 dark:border-stone-800") border px-4 py-2 rounded-full text-xs font-semibold whitespace-nowrap">@chip.Label</button> }</div>
                <div>
                    <div class="flex justify-between mb-4"><h2 class="text-xl font-bold">Available Restaurants</h2><span class="text-xs text-stone-500">Showing @FilteredRestaurants.Count() venue@(FilteredRestaurants.Count() == 1 ? "" : "s")</span></div>
                    @if (!FilteredRestaurants.Any())
                    {
                        <div class="text-center py-16 space-y-3"><i data-lucide="search-x" class="w-12 h-12 text-stone-400 mx-auto"></i><p class="font-bold text-stone-600 dark:text-stone-300">No restaurants found matching your criteria.</p><button type="button" @onclick="ResetFilters" class="px-4 py-2 bg-apple-blue text-white text-xs font-semibold rounded-xl">Clear All Filters</button></div>
                    }
                    else
                    {
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">@foreach (var restaurant in FilteredRestaurants) { <RestaurantCard Restaurant="restaurant" IsFavorite="Favorites.Contains(restaurant.Id)" OnOpen="OpenRestaurant" OnFavorite="ToggleFavorite" OnReserve="StartBooking" /> }</div>
                    }
                </div>
            </section>
        }
        else if (View == "bookings")
        {
            <section class="space-y-6"><div class="flex items-end justify-between"><div><p class="text-xs font-bold text-apple-blue uppercase tracking-widest">Your dining diary</p><h1 class="text-3xl font-bold">My Bookings</h1></div><div class="sf-segmented"><button type="button" class="px-4 py-2 text-xs @(BookingFilter == "active" ? "active" : "")" @onclick="ShowActiveBookings">Upcoming</button><button type="button" class="px-4 py-2 text-xs @(BookingFilter == "past" ? "active" : "")" @onclick="ShowPastBookings">Past</button></div></div>@if (!VisibleBookings.Any()) { <div class="text-center py-16 text-stone-500"><i data-lucide="calendar-x" class="w-10 h-10 mx-auto mb-3"></i>No reservations found.</div> } else { @foreach (var booking in VisibleBookings) { <div class="sf-glass rounded-2xl p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4"><div><h3 class="font-bold">@booking.RestaurantName</h3><p class="text-xs text-stone-500">@booking.Date at @booking.Time · @booking.Guests guests · @booking.Table</p><p class="text-[10px] text-stone-400 mt-1">Reference @booking.Reference</p></div><div class="flex items-center gap-3"><span class="px-3 py-1 rounded-full text-[10px] font-bold bg-apple-green/15 text-emerald-600">@booking.Status</span>@if (booking.Status == "Active") { <button type="button" @onclick="(() => CancelReservation(booking))" class="text-xs text-apple-red font-semibold">Cancel</button> }</div></div> } }</section>
        }
        else
        {
            <section class="space-y-6"><div><p class="text-xs font-bold text-apple-blue uppercase tracking-widest">Restaurant operations</p><h1 class="text-3xl font-bold">Live Floor Control</h1></div><div class="grid lg:grid-cols-[1.4fr_1fr] gap-6"><div class="sf-glass rounded-3xl p-5"><div class="flex justify-between mb-5"><h2 class="font-bold">Ocean Grill & Raw Bar</h2><span class="text-xs text-emerald-600">● Live shift</span></div><div class="rounded-2xl bg-[#F0EEE9] dark:bg-stone-800/60 p-4 overflow-x-auto"><svg viewBox="0 0 800 430" class="min-w-[600px] w-full"><rect x="20" y="20" width="760" height="390" rx="18" fill="none" stroke="currentColor" stroke-opacity=".12" /><text x="400" y="55" text-anchor="middle" fill="currentColor" opacity=".45">MAIN DINING ROOM</text>@foreach (var table in Tables) { <g class="table-node @(table.Occupied ? "occupied" : "") @(SelectedTable?.Name == table.Name ? "selected" : "")" @onclick="(() => SelectTable(table))">@if (table.Round) { <circle cx="@table.X" cy="@table.Y" r="34" fill="@(table.Occupied ? "#9CA3AF" : "#34C759")" fill-opacity=".2" stroke="@(table.Occupied ? "#9CA3AF" : "#34C759")" stroke-width="3" /> } else { <rect x="@(table.X - 45)" y="@(table.Y - 30)" width="90" height="60" rx="12" fill="@(table.Occupied ? "#9CA3AF" : "#34C759")" fill-opacity=".2" stroke="@(table.Occupied ? "#9CA3AF" : "#34C759")" stroke-width="3" /> }<text x="@table.X" y="@(table.Y + 4)" text-anchor="middle" font-size="11" fill="currentColor">@table.Name</text></g> }</svg></div><p class="text-xs mt-4">🟢 Available · ⚪ Reserved · 🔴 Seated · ◻ Cleaning</p>@if (SelectedTable is not null) { <div class="mt-4 p-3 rounded-xl bg-apple-blue/10 flex justify-between text-xs"><span><b>@SelectedTable.Name selected</b><span class="block text-stone-500">@SelectedTable.Capacity seats maximum</span></span><button type="button" @onclick="(() => SelectedTable = null)" class="text-apple-blue font-bold">Clear</button></div> }<button type="button" @onclick="BlockTable" class="mt-4 px-3 py-1.5 bg-[#F0EEE9] dark:bg-stone-800 rounded-lg font-semibold text-xs">+ Manual Table Block</button></div><div class="sf-glass rounded-3xl p-6 space-y-4"><h3 class="font-bold border-b border-stone-200 dark:border-stone-800 pb-3"><i data-lucide="clock" class="w-4 h-4 text-apple-blue inline mr-2"></i>Shift Arrivals Stream</h3>@foreach (var arrival in Arrivals) { <div class="p-3 bg-[#F0EEE9] dark:bg-stone-800/60 rounded-xl border-l-4 @(arrival.Seated ? "border-apple-green" : "border-apple-orange") flex justify-between"><div><b class="text-xs">@arrival.Time · @arrival.Name (@arrival.Guests)</b><span class="block text-[10px] text-stone-500">@arrival.Table</span></div>@if (!arrival.Seated) { <button type="button" @onclick="(() => arrival.Seated = true)" class="px-2 py-1 rounded text-[10px] font-bold bg-apple-blue text-white">Seat Guest</button> } else { <span class="text-[10px] text-emerald-600 font-bold">Seated</span> }</div>}</div></div></section>
        }
    </main>

    @if (SelectedRestaurant is not null)
    {
        <div class="fixed inset-0 z-50 bg-black/60 backdrop-blur-md flex items-center justify-center p-4" role="dialog" aria-modal="true" @onclick="CloseRestaurant">
            <div class="bg-[#F8F7F4] dark:bg-stone-900 w-full max-w-4xl rounded-3xl overflow-hidden max-h-[92vh] overflow-y-auto" @onclick:stopPropagation="true">
                <div class="relative h-64 sm:h-72"><img src="@SelectedRestaurant.Image" class="w-full h-full object-cover" alt="@SelectedRestaurant.Name" /><div class="absolute inset-0 bg-gradient-to-t from-stone-950/90 to-transparent"></div><button type="button" @onclick="CloseRestaurant" class="absolute top-4 right-4 w-9 h-9 rounded-full bg-black/50 text-white" aria-label="Close restaurant details"><i data-lucide="x"></i></button><div class="absolute bottom-5 left-6 text-white"><span class="text-xs text-apple-blue font-bold">@SelectedRestaurant.Cuisine · @SelectedRestaurant.Price · ★ @SelectedRestaurant.Rating</span><h2 class="text-2xl font-bold">@SelectedRestaurant.Name</h2><p class="text-xs text-white/70">@SelectedRestaurant.Location</p></div></div>
                <div class="p-6 space-y-5">
                    <div class="flex gap-2 border-b border-stone-200 dark:border-stone-800 pb-3">
                        <button type="button" @onclick="SelectOverviewTab" class="tab-button @(ModalTab == "overview" ? "active" : "")">Overview & Menu</button>
                        <button type="button" @onclick="SelectMapTab" class="tab-button @(ModalTab == "map" ? "active" : "")">Location & Directions</button>
                        <button type="button" @onclick="SelectReviewsTab" class="tab-button @(ModalTab == "reviews" ? "active" : "")">Reviews & Community</button>
                    </div>
                    @if (ModalTab == "overview")
                    {
                        <div class="space-y-5">
                            <p class="text-sm text-stone-600 dark:text-stone-300">@SelectedRestaurant.Description</p>
                            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3 text-xs">
                                <div class="info-pill"><b>Dress Code</b><span>@SelectedRestaurant.DressCode</span></div>
                                <div class="info-pill"><b>Valet & Parking</b><span>@SelectedRestaurant.Parking</span></div>
                                <div class="info-pill"><b>Corkage Fee</b><span>@SelectedRestaurant.Corkage</span></div>
                                <div class="info-pill"><b>Cancellation</b><span>@SelectedRestaurant.CancellationPolicy</span></div>
                            </div>
                            <h3 class="font-bold">Menu highlights</h3>
                            <div class="grid sm:grid-cols-2 gap-3">
                                @foreach (var dish in SelectedRestaurant.Menu)
                                {
                                    <div class="info-pill flex justify-between"><span><b>@dish.Name</b><small>@dish.Tag</small></span><b>@dish.Price</b></div>
                                }
                            </div>
                        </div>
                    }
                    else if (ModalTab == "map")
                    {
                        <div class="space-y-4">
                            <div class="info-pill"><b>Address</b><span>@SelectedRestaurant.Address</span></div>
                            <div class="info-pill"><b>Cross streets</b><span>@SelectedRestaurant.CrossStreet</span></div>
                            <a target="_blank" href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(SelectedRestaurant.Address)" class="inline-flex px-4 py-2 rounded-xl bg-apple-blue text-white text-xs font-bold">Get Directions</a>
                        </div>
                    }
                    else
                    {
                        <div class="space-y-4">
                            <div class="text-center"><b class="text-3xl">@SelectedRestaurant.Rating</b><p class="text-xs text-stone-500">Based on @SelectedRestaurant.ReviewsCount verified diner reviews</p></div>
                            @foreach (var review in SelectedRestaurant.Reviews)
                            {
                                <div class="info-pill"><div class="flex justify-between"><b>@review.Name</b><span class="text-xs text-stone-400">@review.Date</span></div><div class="text-amber-500">@(new string('★', review.Rating))</div><p>@review.Comment</p></div>
                            }
                        </div>
                    }
                    <div class="flex justify-end gap-3"><button type="button" @onclick="CloseRestaurant" class="px-4 py-2 text-xs font-bold">Close</button><button type="button" @onclick="(() => StartBooking(SelectedRestaurant))" class="px-5 py-2 rounded-xl bg-apple-blue text-white text-xs font-bold">Reserve a table</button></div>
                </div>
            </div>
        </div>
    }

    @if (LocationModal)
    {
        <div class="fixed inset-0 z-50 bg-black/40 backdrop-blur-sm flex items-center justify-center p-4" role="dialog" aria-modal="true" @onclick="(() => LocationModal = false)"><div class="bg-[#F8F7F4] dark:bg-stone-900 w-full max-w-sm rounded-3xl p-6 space-y-3" @onclick:stopPropagation="true"><div class="flex justify-between"><h3 class="font-bold">Select Dining Region</h3><button type="button" @onclick="(() => LocationModal = false)" aria-label="Close location dialog"><i data-lucide="x"></i></button></div>@foreach (var location in Locations) { <button type="button" @onclick="(() => SetLocation(location))" class="w-full text-left px-4 py-3 rounded-xl border border-stone-200 text-sm font-semibold hover:border-apple-blue">@location</button> }</div></div>
    }

    <footer class="border-t border-stone-200 dark:border-stone-800 py-6 text-center text-xs text-stone-500"><p>© 2026 Tableau Reserve Inc. Engineered with Apple Human Interface Guidelines.</p></footer>
</div>
