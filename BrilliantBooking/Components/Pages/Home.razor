@page "/"
@rendermode InteractiveServer
@inherits HomeBase

<PageTitle>Tableau Reserve — Premium Table Reservations</PageTitle>

<div class="reserve-app @(IsDark ? "dark" : "")">
    <header class="sticky top-0 z-40 sf-glass-nav"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
        <button @onclick="GoExplore" class="flex items-center gap-2 text-xl font-bold"><span class="w-8 h-8 rounded-xl bg-apple-blue flex items-center justify-center text-white"><i data-lucide="utensils" class="w-4 h-4"></i></span><span class="hidden sm:inline">Tableau <span class="text-apple-blue font-normal">Reserve</span></span></button>
        <button @onclick="(() => LocationModal = true)" class="hidden md:flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-black/5 dark:bg-white/10 text-xs font-medium"><i data-lucide="map-pin" class="w-3.5 h-3.5 text-apple-blue"></i>@Location<i data-lucide="chevron-down" class="w-3 h-3"></i></button>
        <nav class="sf-segmented flex text-xs font-semibold">@foreach (var item in NavItems) { <button class="px-3 py-2 rounded-md flex items-center gap-1.5 @(View == item.Value ? "active" : "")" @onclick="(() => SwitchView(item.Value))"><i data-lucide="@item.Icon" class="w-3.5 h-3.5"></i><span class="hidden lg:inline">@item.Label</span></button> }</nav>
        <div class="flex items-center gap-2"><button @onclick="ToggleTheme" class="w-9 h-9 rounded-full hover:bg-black/5 dark:hover:bg-white/10"><i data-lucide="@(IsDark ? "sun" : "moon")" class="w-4 h-4"></i></button><span class="w-9 h-9 rounded-full bg-apple-blue text-white flex items-center justify-center text-xs font-bold">JD</span></div>
    </div></header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 min-h-[calc(100vh-9rem)]">
    @if (View == "explore") {
        <section class="space-y-8"><div class="relative rounded-[2rem] overflow-hidden min-h-[280px] flex items-end p-6 sm:p-10 text-white shadow-2xl"><img src="https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=1600&q=85" class="absolute inset-0 w-full h-full object-cover" alt="Restaurant" /><div class="absolute inset-0 bg-gradient-to-r from-stone-950/85 via-stone-950/45 to-transparent"></div><div class="relative max-w-xl space-y-4"><span class="inline-flex gap-2 bg-white/15 backdrop-blur-md px-3 py-1 rounded-full text-[11px] font-bold uppercase"><i data-lucide="sparkles" class="w-3.5 h-3.5 text-apple-orange"></i> Curated dining, effortlessly reserved</span><h1 class="text-3xl sm:text-5xl font-bold">Your table is waiting.</h1><p class="text-sm sm:text-base text-white/80">Discover Cape Town’s most exceptional restaurants and reserve your perfect table in seconds.</p></div></div>
        <div class="flex flex-col lg:flex-row gap-3"><div class="flex-1 relative"><i data-lucide="search" class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-stone-400"></i><input @bind="Search" @bind:event="oninput" class="w-full bg-[#F0EEE9] dark:bg-stone-800 rounded-xl py-3 pl-11 pr-4 text-sm outline-none" placeholder="Search restaurants, cuisines or locations..." /></div><select @bind="Cuisine" class="bg-[#F0EEE9] dark:bg-stone-800 text-xs font-semibold py-3 px-3 rounded-xl"><option value="all">All Cuisines</option><option>Seafood</option><option>French</option><option>Japanese</option><option>Italian</option><option>Farm-to-Table</option></select><select @bind="Price" class="bg-[#F0EEE9] dark:bg-stone-800 text-xs font-semibold py-3 px-3 rounded-xl"><option value="all">All Prices</option><option>$$</option><option>$$$</option><option>$$$$</option></select></div>
        <div class="flex gap-2 overflow-x-auto pb-1">@foreach (var chip in Categories) { <button @onclick="(() => SetCategory(chip.Value))" class="@(Category == chip.Value ? "bg-apple-blue text-white border-apple-blue" : "border-stone-300/60 dark:border-stone-800") border px-4 py-2 rounded-full text-xs font-semibold whitespace-nowrap">@chip.Label</button> }</div>
        <div><div class="flex justify-between mb-4"><h2 class="text-xl font-bold">Available Restaurants</h2><span class="text-xs text-stone-500">Showing @FilteredRestaurants.Count() venues</span></div><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">@foreach (var restaurant in FilteredRestaurants) { <RestaurantCard Restaurant="restaurant" IsFavorite="Favorites.Contains(restaurant.Id)" OnOpen="OpenRestaurant" OnFavorite="ToggleFavorite" /> }</div></div></section>
    } else if (View == "bookings") {
        <section class="space-y-6"><div class="flex items-end justify-between"><div><p class="text-xs font-bold text-apple-blue uppercase tracking-widest">Your dining diary</p><h1 class="text-3xl font-bold">My Bookings</h1></div><div class="sf-segmented"><button class="px-4 py-2 text-xs @(BookingFilter == "active" ? "active" : "")" @onclick="ShowActiveBookings">Upcoming</button><button class="px-4 py-2 text-xs @(BookingFilter == "past" ? "active" : "")" @onclick="ShowPastBookings">Past</button></div></div>@foreach (var booking in VisibleBookings) { <div class="sf-glass rounded-2xl p-5 flex items-center justify-between"><div class="flex items-center gap-4"><div class="w-12 h-12 rounded-2xl bg-apple-blue/10 text-apple-blue flex items-center justify-center"><i data-lucide="calendar-days"></i></div><div><h3 class="font-bold">@booking.RestaurantName</h3><p class="text-xs text-stone-500">@booking.Date at @booking.Time · @booking.Guests guests · @booking.Table</p></div></div><span class="px-3 py-1 rounded-full text-[10px] font-bold bg-apple-green/15 text-emerald-600">@booking.Status</span></div>}</section>
    } else {
        <section class="space-y-6"><div><p class="text-xs font-bold text-apple-blue uppercase tracking-widest">Restaurant operations</p><h1 class="text-3xl font-bold">Live Floor Control</h1></div><div class="grid lg:grid-cols-[1.4fr_1fr] gap-6"><div class="sf-glass rounded-3xl p-5"><div class="flex justify-between mb-5"><h2 class="font-bold">Ocean Grill & Raw Bar</h2><span class="text-xs text-emerald-600">● Live shift</span></div><div class="rounded-2xl bg-[#F0EEE9] dark:bg-stone-800/60 p-4 overflow-x-auto"><svg viewBox="0 0 800 430" class="min-w-[600px] w-full"><rect x="20" y="20" width="760" height="390" rx="18" fill="none" stroke="currentColor" stroke-opacity=".12" /><text x="400" y="55" text-anchor="middle" fill="currentColor" opacity=".45">MAIN DINING ROOM</text>@foreach (var table in Tables) { <g class="table-node @(table.Occupied ? "occupied" : "") @(SelectedTable?.Name == table.Name ? "selected" : "")" @onclick="(() => SelectTable(table))"><circle cx="@table.X" cy="@table.Y" r="34" fill="@(table.Occupied ? "#9CA3AF" : "#34C759")" fill-opacity=".2" stroke="@(table.Occupied ? "#9CA3AF" : "#34C759")" stroke-width="3" /><text x="@table.X" y="@(table.Y + 4)" text-anchor="middle" font-size="11" fill="currentColor">@table.Name</text></g> }</svg></div><p class="text-xs mt-4">🟢 Available · ⚪ Reserved · 🔴 Seated</p></div><div class="sf-glass rounded-3xl p-6 space-y-4"><h3 class="font-bold border-b border-stone-200 dark:border-stone-800 pb-3"><i data-lucide="clock" class="w-4 h-4 text-apple-blue inline mr-2"></i>Shift Arrivals Stream</h3>@foreach (var arrival in Arrivals) { <div class="p-3 bg-[#F0EEE9] dark:bg-stone-800/60 rounded-xl border-l-4 @(arrival.Seated ? "border-apple-green" : "border-apple-orange") flex justify-between"><div><b class="text-xs">@arrival.Time · @arrival.Name (@arrival.Guests)</b><span class="block text-[10px] text-stone-500">@arrival.Table</span></div>@if (!arrival.Seated) { <button @onclick="(() => arrival.Seated = true)" class="px-2 py-1 rounded text-[10px] font-bold bg-apple-blue text-white">Seat Guest</button> } else { <span class="text-[10px] text-emerald-600 font-bold">Seated</span> }</div>}</div></div></section>
    }</main>

    @if (SelectedRestaurant is not null) { <div class="fixed inset-0 z-50 bg-black/60 backdrop-blur-md flex items-center justify-center p-4" @onclick="CloseRestaurant"><div class="bg-[#F8F7F4] dark:bg-stone-900 w-full max-w-3xl rounded-3xl overflow-hidden max-h-[92vh] overflow-y-auto" @onclick:stopPropagation="true"><div class="relative h-64"><img src="@SelectedRestaurant.Image" class="w-full h-full object-cover" alt="@SelectedRestaurant.Name" /><div class="absolute inset-0 bg-gradient-to-t from-stone-950/90 to-transparent"></div><button @onclick="CloseRestaurant" class="absolute top-4 right-4 w-9 h-9 rounded-full bg-black/50 text-white"><i data-lucide="x"></i></button><div class="absolute bottom-5 left-6 text-white"><span class="text-xs text-apple-blue font-bold">@SelectedRestaurant.Cuisine · @SelectedRestaurant.Price</span><h2 class="text-2xl font-bold">@SelectedRestaurant.Name</h2><p class="text-xs text-white/70">@SelectedRestaurant.Location</p></div></div><div class="p-6 space-y-5"><p class="text-sm text-stone-600 dark:text-stone-300">@SelectedRestaurant.Description</p><div class="grid sm:grid-cols-3 gap-3 text-xs"><div class="p-3 bg-[#F0EEE9] dark:bg-stone-800 rounded-xl"><b>Dress code</b><span class="block text-stone-500">@SelectedRestaurant.DressCode</span></div><div class="p-3 bg-[#F0EEE9] dark:bg-stone-800 rounded-xl"><b>Parking</b><span class="block text-stone-500">@SelectedRestaurant.Parking</span></div><div class="p-3 bg-[#F0EEE9] dark:bg-stone-800 rounded-xl"><b>Rating</b><span class="block text-amber-500">★ @SelectedRestaurant.Rating (@SelectedRestaurant.ReviewsCount)</span></div></div><h3 class="font-bold">Menu highlights</h3><div class="grid sm:grid-cols-2 gap-3">@foreach (var dish in SelectedRestaurant.Menu) { <div class="p-3 bg-[#F0EEE9] dark:bg-stone-800 rounded-xl flex justify-between text-xs"><span><b>@dish.Name</b><small class="block text-apple-blue">@dish.Tag</small></span><b>@dish.Price</b></div>}</div><div class="flex justify-end gap-3"><button @onclick="CloseRestaurant" class="px-4 py-2 text-xs font-bold">Close</button><button @onclick="(() => StartBooking(SelectedRestaurant))" class="px-5 py-2 rounded-xl bg-apple-blue text-white text-xs font-bold">Reserve a table</button></div></div></div></div> }
    @if (BookingRestaurant is not null) { <div class="fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4"><div class="bg-[#F8F7F4] dark:bg-stone-900 w-full max-w-xl rounded-3xl p-6 sm:p-8"><div class="flex justify-between mb-6"><div><p class="text-xs text-apple-blue font-bold uppercase">Reservation</p><h2 class="text-xl font-bold">@BookingRestaurant.Name</h2></div><button @onclick="CancelBooking"><i data-lucide="x"></i></button></div><div class="flex justify-between text-[11px] font-bold mb-2"><span class="text-apple-blue">1. Time & guests</span><span class="@(BookingStep > 1 ? "text-apple-blue" : "text-stone-400")">2. Table</span><span class="@(BookingStep > 2 ? "text-apple-blue" : "text-stone-400")">3. Details</span><span class="@(BookingStep > 3 ? "text-apple-blue" : "text-stone-400")">4. Done</span></div><div class="h-1.5 bg-stone-200 rounded-full mb-6"><div class="h-full bg-apple-blue rounded-full" style="width:@(BookingStep * 25)%"></div></div>@if (BookingStep == 1) { <div class="space-y-4"><label class="block text-xs font-bold">Party size<select @bind="PartySize" class="field mt-2"><option>1</option><option>2</option><option>4</option><option>6</option><option>8</option></select></label><label class="block text-xs font-bold">Date<input type="date" @bind="BookingDate" class="field mt-2" /></label><div><label class="text-xs font-bold">Available times</label><div class="flex flex-wrap gap-2 mt-2">@foreach (var slot in BookingRestaurant.Slots) { <button @onclick="(() => TimeSlot = slot)" class="px-3 py-2 rounded-xl text-xs @(TimeSlot == slot ? "bg-apple-blue text-white" : "bg-[#F0EEE9] dark:bg-stone-800")">@slot</button> }</div></div></div> } else if (BookingStep == 2) { <div class="space-y-3"><p class="text-sm">Choose an available table.</p>@foreach (var table in Tables.Where(t => !t.Occupied)) { <button @onclick="(() => BookingTable = table)" class="w-full p-3 rounded-xl text-left border @(BookingTable?.Name == table.Name ? "border-apple-blue bg-apple-blue/10" : "border-stone-200")"><b class="text-sm">@table.Name</b><span class="block text-xs text-stone-500">@table.Capacity seats · window view</span></button>}</div> } else if (BookingStep == 3) { <div class="space-y-3"><input @bind="GuestName" class="field" placeholder="Full name" /><input @bind="GuestEmail" class="field" placeholder="Email address" type="email" /><input @bind="GuestPhone" class="field" placeholder="Phone number" type="tel" /><textarea @bind="GuestNotes" class="field" placeholder="Special requests" rows="3"></textarea></div> } else { <div class="text-center py-8"><i data-lucide="check-circle" class="w-12 h-12 mx-auto text-apple-green"></i><h3 class="text-xl font-bold mt-3">Reservation confirmed</h3><p class="text-sm text-stone-500">Confirmation code: <b>@ConfirmationCode</b></p></div>}<div class="flex justify-between mt-7"><button @onclick="PreviousBookingStep" class="text-xs font-bold @(BookingStep == 1 || BookingStep == 4 ? "invisible" : "")">Back</button>@if (BookingStep < 4) { <button @onclick="NextBookingStep" disabled="@(BookingStep == 1 && string.IsNullOrWhiteSpace(TimeSlot))" class="px-5 py-2 rounded-xl bg-apple-blue text-white text-xs font-bold disabled:opacity-40">@(BookingStep == 3 ? "Confirm reservation" : "Continue")</button> } else { <button @onclick="CancelBooking" class="px-5 py-2 rounded-xl bg-apple-blue text-white text-xs font-bold">Done</button> }</div></div></div> }
    @if (LocationModal) { <div class="fixed inset-0 z-50 bg-black/40 flex items-center justify-center p-4" @onclick="(() => LocationModal = false)"><div class="bg-[#F8F7F4] dark:bg-stone-900 w-full max-w-sm rounded-3xl p-6 space-y-3" @onclick:stopPropagation="true"><div class="flex justify-between"><h3 class="font-bold">Select Dining Region</h3><button @onclick="(() => LocationModal = false)"><i data-lucide="x"></i></button></div>@foreach (var location in Locations) { <button @onclick="(() => SetLocation(location))" class="w-full text-left px-4 py-3 rounded-xl border border-stone-200 text-sm font-semibold hover:border-apple-blue">@location</button> }</div></div> }
    <footer class="border-t border-stone-200 dark:border-stone-800 py-6 text-center text-xs text-stone-500"><p>© 2026 Tableau Reserve Inc. Engineered with Apple Human Interface Guidelines.</p></footer>
</div>
