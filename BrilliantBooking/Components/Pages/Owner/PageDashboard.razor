@page "/Owner/Dashboard"
@rendermode @(new InteractiveServerRenderMode(false))
@layout PrivateLayout
@inherits PageBase

@using Data.VO.Booking;
@using Data.VO.Operations


<main class="dashboard-shell">
    <section class="operations-section">
        <div class="operations-banner apple-card">
            <div class="operations-heading-row">
                <div>
                    <div class="operations-title-row">
                        <span class="live-indicator" aria-hidden="true"></span>
                        <h1>Floor Operations Console</h1>
                    </div>
                    <p class="muted-copy">Live shift capacity, table statuses, and walk-in allocation</p>
                </div>

                <div class="operations-actions">
                    <label class="sr-only" for="venue-select">Operational venue</label>
                    <select id="venue-select" class="venue-select" value="@Search.Resturant?.Id" @onchange="OnVenueChanged">
                        @for (var index = 0 ; index < ResturantList.Count ; index++)
                        {
                            <option value="@ResturantList[index].Id">@ResturantList[index].Name</option>
                        }
                    </select>
                    <button class="icon-button" type="button" title="Refresh live map" aria-label="Refresh live map" @onclick="RefreshOperationsAsync">
                        <i data-lucide="refresh-cw" class="icon"></i>
                    </button>
                </div>
            </div>

            <div class="metrics-grid">
                <div class="metric-card">
                    <span class="metric-label">Total Shift Covers</span>
                    <strong class="metric-value">@TotalShiftCovers / @ShiftCapacity</strong>
                    <span class="metric-support positive">@CapacityPercentage% Capacity</span>
                </div>
                <div class="metric-card">
                    <span class="metric-label">Active Tables</span>
                    <strong class="metric-value blue">@ActiveTableCount Active</strong>
                    <span class="metric-support">@ReservedTableCount Reserved</span>
                </div>
                <div class="metric-card">
                    <span class="metric-label">Upcoming Arrivals</span>
                    <strong class="metric-value orange">@Arrivals.Count Parties</strong>
                    <span class="metric-support">Next at @NextArrivalTime</span>
                </div>
                @* TODO: Keep this card commented until ArrivalVO has a first-class VIP designation property. *@
                @* <div class="metric-card">
                    <span class="metric-label">VIP Guests Tonight</span>
                    <strong class="metric-value purple">3 VIPs</strong>
                    <span class="metric-support purple-copy">Special Dietary Notes</span>
                </div> *@
            </div>
        </div>

        <div class="operations-content-grid">
            <section class="floor-card apple-card" aria-labelledby="floor-status-heading">
                <div class="card-heading-row">
                    <h2 id="floor-status-heading"><i data-lucide="map" class="heading-icon"></i>Floor Status Manager</h2>
                    <span class="muted-copy">Select a table to change status</span>
                </div>

                @if (FloorList.Count > 0)
                {
                    <div class="floor-tabs" role="tablist" aria-label="Restaurant floors">
                        @for (var index = 0; index < FloorList.Count; index++)
                        {
                            var floorIndex = index;
                            <button class="floor-tab @(_selectedFloorIndex == floorIndex ? "active" : string.Empty)"
                                    type="button"
                                    role="tab"
                                    aria-selected="@(_selectedFloorIndex == floorIndex)"
                                    @onclick="() => SelectFloor(floorIndex)">
                                @FloorList[floorIndex].Name
                            </button>
                        }
                    </div>
                }

                <div class="floorplan-frame">
                    <svg viewBox="0 0 800 @GetFloorPlanHeight()" class="floorplan" role="img" aria-label="Live floor management map for @(SelectedFloor?.Name ?? "the selected floor")">
                        <rect x="20" y="20" width="760" height="@GetFloorBoundaryHeight()" rx="20" class="floor-boundary" />
                        <text x="40" y="45" class="floor-caption">LIVE FLOOR MANAGEMENT MAP</text>

                        @if (TableList.Count > 0)
                        {
                            @for (var index = 0; index < TableList.Count; index++)
                            {
                                var tableIndex = index;
                                var table = TableList[tableIndex];
                                <g class="table-node @(GetTableClass(table))" tabindex="0" role="button" aria-label="@GetTableLabel(table)" @onclick="() => ToggleTableStatus(table)">
                                    <circle cx="@GetTableX(tableIndex)" cy="@GetTableY(tableIndex)" r="35" />
                                    <text><tspan x="@GetTableX(tableIndex)" y="@(GetTableY(tableIndex) + 4)" class="table-name">@table.Name</tspan></text>
                                    <text><tspan x="@GetTableX(tableIndex)" y="@(GetTableY(tableIndex) + 50)" class="table-status">@GetTableStatus(table)</tspan></text>
                                </g>
                            }
                        }
                    </svg>
                    @if (TableList.Count == 0)
                    {
                        <div class="floor-empty-state">No tables on this floor</div>
                    }
                </div>

                <div class="floor-footer">
                    <div class="status-legend" aria-label="Table status legend">
                        <span><i class="status-dot available"></i>Available</span>
                        <span><i class="status-dot reserved"></i>Reserved</span>
                        <span><i class="status-dot seated"></i>Seated</span>
                        <span><i class="status-dot selected"></i>Selected</span>
                    </div>
                    @* TODO: TableVO has no Blocked/Cleaning status or persistence command yet. Keep this action deferred until that VO contract exists. *@
                    @* <button class="secondary-button" type="button">+ Manual Table Block</button> *@
                </div>
            </section>

            <section class="arrivals-card apple-card" aria-labelledby="arrivals-heading">
                <h2 id="arrivals-heading" class="card-heading"><i data-lucide="clock" class="heading-icon"></i>Shift Arrivals Stream</h2>
                <div class="arrivals-list">
                    @foreach (var arrival in ArrivalList)
                    {
                        <article class="arrival-item @GetArrivalClass(arrival)">
                            <div>
                                <div class="arrival-title-row">
                                    <strong>@arrival.Time.ToString(@"hh\:mm")</strong>
                                    <span>@arrival.GuestName (@arrival.PartySize)</span>
                                </div>
                                <span class="arrival-detail">@arrival.TableName • @arrival.Tags</span>
                            </div>
                            @if (arrival.Status == ArrivalVO.ArrivalStatus.Seated)
                            {
                                <span class="arrival-status seated">@arrival.Status</span>
                            }
                            else
                            {
                                <button class="seat-button" type="button" @onclick="() => SeatGuest(arrival)">@arrival.Status</button>
                            }
                        </article>
                    }
                </div>
            </section>
        </div>

        <section class="bookings-card apple-card" aria-labelledby="bookings-heading">
            <div class="card-heading-row bookings-heading-row">
                <div>
                    <h2 id="bookings-heading" class="card-heading"><i data-lucide="calendar-days" class="heading-icon"></i>Booking Management</h2>
                    <p class="muted-copy">Search reservations, review guest details, and update the booking status.</p>
                </div>
                <span class="booking-count">@BookingList.Count booking@(BookingList.Count == 1 ? string.Empty : "s")</span>
            </div>

            <div class="booking-filters" role="search" aria-label="Filter bookings">
                <div class="booking-filter booking-search-filter">
                    <label for="booking-search">Search bookings</label>
                    <div class="search-input-wrapper">
                        <i data-lucide="search" class="filter-icon" aria-hidden="true"></i>
                        <input id="booking-search" type="search" value="@Search.Text" placeholder="Reference, guest, phone, occasion..." @onchange="OnBookingTextChanged" />
                    </div>
                </div>
                <div class="booking-filter">
                    <label for="booking-from-date">From date</label>
                    <input id="booking-from-date" type="date" value="@(Search.FromDate?.ToString("yyyy-MM-dd"))" @onchange="OnFromDateChanged" />
                </div>
                <div class="booking-filter">
                    <label for="booking-to-date">To date</label>
                    <input id="booking-to-date" type="date" value="@(Search.ToDate?.ToString("yyyy-MM-dd"))" @onchange="OnToDateChanged" />
                </div>
                <button class="icon-button booking-refresh-button" type="button" title="Refresh bookings" aria-label="Refresh bookings" @onclick="RefreshBooking">
                    <i data-lucide="refresh-cw" class="icon" aria-hidden="true"></i>
                </button>
                <button class="secondary-button booking-reset-button" type="button" @onclick="ResetBookingFiltersAsync">Reset</button>
                <div class="booking-filter booking-status-filter">
                    <span class="booking-filter-label">Status</span>
                    <div class="booking-status-toggle-list" role="group" aria-label="Filter bookings by status">
                        @foreach (var status in BookingStatuses)
                        {
                            var isSelected = Search.BookingStatusList.Contains(status);
                            <button type="button"
                                    class="booking-status-toggle @(isSelected ? "active" : string.Empty)"
                                    aria-pressed="@isSelected"
                                    @onclick="() => ToggleBookingStatus(status)">
                                @GetBookingStatusLabel(status)
                            </button>
                        }
                    </div>
                </div>
            </div>

            @if (BookingList.Count == 0)
            {
                <div class="booking-empty-state" role="status">
                    <i data-lucide="calendar-search" class="empty-state-icon" aria-hidden="true"></i>
                    <strong>No bookings found</strong>
                    <span>Try adjusting the date range or search term.</span>
                </div>
            }
            else
            {
                <div class="booking-table-wrapper">
                    <table class="booking-table">
                        <caption class="sr-only">Bookings for the selected restaurant</caption>
                        <thead>
                            <tr>
                                <th scope="col">Booking</th>
                                <th scope="col">Guest</th>
                                <th scope="col">Date &amp; time</th>
                                <th scope="col">Party</th>
                                <th scope="col">Table</th>
                                <th scope="col">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var booking in BookingList)
                            {
                                <tr>
                                    <td>
                                        <strong class="booking-reference">@(string.IsNullOrWhiteSpace(booking.Reference) ? "Unassigned" : booking.Reference)</strong>
                                        <span class="booking-secondary-text">@booking.Occasion</span>
                                    </td>
                                    <td>
                                        <strong>@(booking.Customer?.Name ?? "Unknown guest")</strong>
                                        <span class="booking-secondary-text">@(booking.Customer?.Phone ?? booking.Customer?.Email ?? "No contact details")</span>
                                    </td>
                                    <td>
                                        <strong>@booking.Date.ToString("dd MMM yyyy")</strong>
                                        <span class="booking-secondary-text">@booking.FromTime.ToString(@"hh\:mm") – @booking.ToTime.ToString(@"hh\:mm")</span>
                                    </td>
                                    <td>@booking.GuestCount guests</td>
                                    <td>@(booking.BookingTable?.Name ?? "Unassigned")</td>
                                    <td>
                                        @if (DefaultStatus.Contains(booking.Status))
                                        {
                                            <label class="sr-only" for="booking-status-@booking.Id">Status for @booking.Reference</label>
                                            <select id="booking-status-@booking.Id" class="booking-status-select status-@booking.Status.ToString().ToLowerInvariant()" value="@booking.Status" @onchange="args => OnBookingStatusChanged(booking, args)">
                                                @* @foreach (var status in DefaultStatus)
                                                {
                                                    <option value="@status">@status</option>
                                                } *@
                                                @if(booking.Status == BookingVO.BookingStatus.Active)
                                                {
                                                    <option value="@BookingVO.BookingStatus.Active">@BookingVO.BookingStatus.Active</option>
                                                }
                                                <option value="@BookingVO.BookingStatus.CheckedIn">@BookingVO.BookingStatus.CheckedIn</option>
                                                <option value="@BookingVO.BookingStatus.Cancelled">@BookingVO.BookingStatus.Cancelled</option>
                                            </select>
                                        }
                                        else
                                        {
                                            <label class="booking-status-label status-@booking.Status.ToString().ToLowerInvariant()">@GetBookingStatusLabel(booking.Status)</label>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </section>
</main>


