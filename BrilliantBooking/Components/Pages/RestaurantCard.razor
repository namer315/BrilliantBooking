<div class="sf-glass rounded-3xl overflow-hidden shadow-apple-card hover:shadow-apple-hover transition-all duration-300 hover:-translate-y-1 flex flex-col justify-between border border-stone-200/80 dark:border-stone-800 cursor-pointer group" @onclick="(() => OnOpen.InvokeAsync(Restaurant))">
    <div><div class="relative h-52 w-full overflow-hidden"><img src="@Restaurant.Image" alt="@Restaurant.Name" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" /><div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent"></div><span class="absolute top-3 left-3 bg-black/60 backdrop-blur-md text-white text-[10px] font-bold px-2.5 py-1 rounded-full uppercase">@Restaurant.Badge</span><button @onclick:stopPropagation="true" @onclick="(() => OnFavorite.InvokeAsync(Restaurant))" class="absolute top-3 right-3 w-8 h-8 rounded-full bg-black/50 text-white flex items-center justify-center hover:scale-110 transition"><i data-lucide="heart" class="w-4 h-4 @(IsFavorite ? "text-apple-red fill-apple-red" : "")"></i></button><span class="absolute bottom-3 right-3 bg-white/90 text-stone-900 text-xs font-bold px-2.5 py-1 rounded-full">@Restaurant.Price</span></div><div class="p-5 space-y-2"><div class="flex items-center justify-between"><span class="text-xs font-semibold text-apple-blue uppercase tracking-wide">@Restaurant.Cuisine</span><span class="text-xs font-bold text-amber-500">★ @Restaurant.Rating <span class="text-stone-400 font-normal">(@Restaurant.ReviewsCount)</span></span></div><h3 class="text-lg font-bold tracking-tight">@Restaurant.Name</h3><p class="text-xs text-stone-500 dark:text-stone-400 line-clamp-2">@Restaurant.Description</p><div class="flex items-center gap-1.5 text-xs text-stone-400 pt-1"><i data-lucide="map-pin" class="w-3.5 h-3.5 text-apple-blue"></i>@Restaurant.Location</div></div></div>
    <div class="px-5 pb-5"><button @onclick:stopPropagation="true" @onclick="(() => OnOpen.InvokeAsync(Restaurant))" class="w-full rounded-xl bg-apple-blue text-white py-2.5 text-xs font-bold hover:bg-apple-blue-hover transition">View restaurant</button></div>
</div>

@code {
    [Parameter, EditorRequired] public HomeBase.Restaurant Restaurant { get; set; } = null!;
    [Parameter] public bool IsFavorite { get; set; }
    [Parameter] public EventCallback<HomeBase.Restaurant> OnOpen { get; set; }
    [Parameter] public EventCallback<HomeBase.Restaurant> OnFavorite { get; set; }
}
