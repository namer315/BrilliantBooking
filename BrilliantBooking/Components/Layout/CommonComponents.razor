@rendermode @(new InteractiveServerRenderMode(false))

<MessageBox IsVisible="@MessageBoxService.IsVisible"
            Title="@MessageBoxService.Title"
            Message="@MessageBoxService.Message"
            Type="@MessageBoxService.Type"
            OnClose="@(() => MessageBoxService.Close())" />

<Toast IsVisible="@MessageBoxService.IsToastVisible"
       Title="@MessageBoxService.ToastTitle"
       Message="@MessageBoxService.ToastMessage"
       Type="@MessageBoxService.ToastType"
       OnClose="@(() => MessageBoxService.CloseToast())" />

<Loading />
