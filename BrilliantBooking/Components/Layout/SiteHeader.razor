@rendermode @(new InteractiveServerRenderMode(false))

@inject BookingUiStateService UiState
@inject NavigationManager Navigation
@inject IJSRuntime JavaScript

@implements IDisposable
@using BrilliantBooking.Services

<header class="sticky top-0 z-40 sf-glass-nav transition-colors duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center space-x-4">
            <a href="/" class="flex items-center space-x-2 text-xl font-semibold tracking-tight focus:outline-none focus-visible:ring-2 focus-visible:ring-apple-blue rounded-xl">
                <span class="w-8 h-8 rounded-xl bg-apple-blue flex items-center justify-center text-white shadow-md shadow-apple-blue/30">
                    <i data-lucide="utensils" class="w-4 h-4"></i>
                </span>
                <span class="bg-gradient-to-r from-stone-900 via-stone-800 to-stone-900 dark:from-white dark:to-stone-300 bg-clip-text text-transparent font-bold">
                    Tableau <span class="text-apple-blue font-normal">Reserve</span>
                </span>
            </a>

            <button type="button" class="hidden md:flex items-center space-x-1.5 px-3 py-1.5 rounded-full bg-black/5 dark:bg-white/10 text-xs font-medium cursor-pointer hover:bg-black/10 transition" @onclick="UiState.ToggleLocationModal">
                <i data-lucide="map-pin" class="w-3.5 h-3.5 text-apple-blue"></i>
                <span>@UiState.Location</span>
                <i data-lucide="chevron-down" class="w-3 h-3 text-stone-400"></i>
            </button>
        </div>

        @* <nav class="hidden lg:flex items-center space-x-1 sf-segmented p-1">
            <button @onclick='() => UiState.SwitchView("explore")' class="@(UiState.View == "explore" ? "active" : "text-stone-600 dark:text-stone-300") px-4 py-1.5 text-xs font-medium rounded-md transition-all">Explore</button>
            <button @onclick='() => UiState.SwitchView("bookings")' class="@(UiState.View == "bookings" ? "active" : "text-stone-600 dark:text-stone-300") px-4 py-1.5 text-xs font-medium rounded-md transition-all">My Bookings</button>
            <button @onclick='() => UiState.SwitchView("ops")' class="@(UiState.View == "ops" ? "active" : "text-stone-600 dark:text-stone-300") px-4 py-1.5 text-xs font-medium rounded-md transition-all flex items-center space-x-1">
                <span class="w-2 h-2 rounded-full bg-apple-green animate-pulse"></span>
                <span>Live Operations</span>
            </button>
        </nav> *@
        <nav class="hidden lg:flex items-center space-x-1 sf-segmented p-1" aria-label="Main">
            <a href="/Explore" class="@NavClass(IsExploreActive) px-4 py-1.5 text-xs font-medium rounded-md transition-all focus-visible:ring-2 focus-visible:ring-apple-blue" aria-current="@(IsExploreActive ? "page" : null)">Explore</a>
            <a href="/bookings" class="@NavClass(IsActive("bookings")) px-4 py-1.5 text-xs font-medium rounded-md transition-all focus-visible:ring-2 focus-visible:ring-apple-blue" aria-current="@(IsActive("bookings") ? "page" : null)">My Bookings</a>
            <a href="/ops" class="@NavClass(IsActive("ops")) px-4 py-1.5 text-xs font-medium rounded-md transition-all flex items-center space-x-1 focus-visible:ring-2 focus-visible:ring-apple-blue" aria-current="@(IsActive("ops") ? "page" : null)">
                <span class="w-2 h-2 rounded-full bg-apple-green animate-pulse"></span>
                <span>Live Operations</span>
            </a>
        </nav>

        <div class="flex items-center space-x-3">
            <button type="button" @onclick="UiState.ToggleFavoritesOnlyFilter" class="px-3 py-1.5 rounded-full bg-stone-200/60 dark:bg-stone-800 text-xs font-semibold flex items-center space-x-1 hover:bg-stone-300/60 transition @(UiState.FavoritesOnly ? "bg-apple-red/20 text-apple-red border border-apple-red/40" : "")">
                <i data-lucide="heart" class="w-3.5 h-3.5 text-apple-red"></i>
                <span>Saved (@UiState.Favorites.Count)</span>
            </button>

            <button type="button" @onclick="ToggleTheme" class="p-2 rounded-full hover:bg-black/5 dark:hover:bg-white/10 transition text-stone-600 dark:text-stone-300" title="Toggle Light/Dark Theme">
                <i data-lucide="@(UiState.IsDark ? "sun" : "moon")" class="w-4 h-4"></i>
            </button>

            <button type="button" @onclick="UiState.ToggleMobileMenu" class="lg:hidden p-2 rounded-xl hover:bg-black/5 dark:hover:bg-white/10 transition" aria-label="Toggle menu">
                <i data-lucide="menu" class="w-5 h-5"></i>
            </button>
        </div>
    </div>

    @if (UiState.MobileMenuOpen)
    {
        <div class="lg:hidden border-b border-stone-200 dark:border-stone-800 bg-[#F8F7F4]/95 dark:bg-stone-900/95 backdrop-blur-xl px-4 py-3 space-y-2">
            <a href="/" class="block w-full text-left px-3 py-2 rounded-lg text-sm font-medium hover:bg-stone-200/50 dark:hover:bg-stone-800">Explore Restaurants</a>
            <a href="/bookings" class="block w-full text-left px-3 py-2 rounded-lg text-sm font-medium hover:bg-stone-200/50 dark:hover:bg-stone-800">My Reservations</a>
            <a href="/ops" class="flex w-full text-left px-3 py-2 rounded-lg text-sm font-medium hover:bg-stone-200/50 dark:hover:bg-stone-800 items-center justify-between">
                <span>Restaurant Staff Operations</span>
                <span class="text-xs bg-apple-green/20 text-apple-green font-semibold px-2 py-0.5 rounded-full">Live</span>
            </a>
        </div>
    }
</header>

@code {
    private bool IsExploreActive => IsActive("") || IsActive("reserve");

    protected override void OnInitialized()
    {
        UiState.Changed += OnStateChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JavaScript.InvokeVoidAsync("refreshReserveIcons");
    }

    private bool IsActive(string route) => Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/').Contains(route);
    // string.Equals(Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/') , route , StringComparison.OrdinalIgnoreCase);

    private static string NavClass(bool active) =>
        active ? "active" : "text-stone-600 dark:text-stone-300";

    private async Task ToggleTheme()
    {
        UiState.ToggleTheme();
        await JavaScript.InvokeVoidAsync("setDarkMode" , UiState.IsDark);
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender , Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        UiState.Changed -= OnStateChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
