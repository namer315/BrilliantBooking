@page
@model ERPBooking.Pages.IndexModel
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#ffffff">
  <meta name="description" content="Discover Cape Town restaurants and find a table for your next night out.">
  <title>@Model.PageTitle | @Model.ApplicationName</title>
  <link rel="preconnect" href="https://images.unsplash.com">
  <link rel="stylesheet" href="/styles.css">
  <link rel="stylesheet" href="/listing.css">
</head>
<body class="listing-page">
  <header class="site-header">
    <a class="brand" href="/" aria-label="Cape & Table home">
      <span class="brand-icon" aria-hidden="true">C</span>
      <span>Cape <span class="brand-amp">&amp;</span> Table</span>
    </a>
    <form method="get" action="/" class="pill-search" role="search" aria-label="Search restaurants">
      <input type="hidden" name="area" value="@Model.Area">
      <input type="hidden" name="cuisine" value="@Model.Cuisine">
      <input type="hidden" name="priceLevel" value="@Model.PriceLevel">
      <label class="pill-field pill-query">
        <span class="visually-hidden">Search restaurants</span>
        <input type="search" name="query" value="@Model.Query" placeholder="Search restaurants">
      </label>
      <label class="pill-field">
        <span class="visually-hidden">Date</span>
        <input type="date" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" min="@ERPBooking.Booking.CapeTownClock.Today.ToString("yyyy-MM-dd")">
      </label>
      <label class="pill-field">
        <span class="visually-hidden">Time</span>
        <select name="time">
          <option value="">Any time</option>
          @foreach (var slot in new[] { "17:00", "17:30", "18:00", "18:30", "19:00", "19:30", "20:00", "20:30", "21:00" })
          {
            <option value="@slot" selected="@(Model.Time == slot)">@slot</option>
          }
        </select>
      </label>
      <label class="pill-field">
        <span class="visually-hidden">Party size</span>
        <select name="guests">
          @for (var count = 1; count <= 8; count++)
          {
            <option value="@count" selected="@(Model.Guests == count)">@count @(count == 1 ? "guest" : "guests")</option>
          }
        </select>
      </label>
      <button class="pill-button" type="submit" aria-label="Search restaurants"><span aria-hidden="true">&#9906;</span></button>
    </form>
    <nav class="header-links" aria-label="Main navigation">
      <a href="#how-it-works">How it works</a>
    </nav>
  </header>
  <p class="prototype-notice" role="note">Demo experience: restaurant listings and availability are sample data. Bookings are saved locally and not sent to restaurants.</p>

  <main>
    <section class="listing-intro" aria-labelledby="listing-title">
      <h1 id="listing-title">Restaurants in Cape Town</h1>
    </section>

    <div class="filter-bar">
      <div class="chip-row" role="group" aria-label="Filter restaurants">
        <a class="chip @(string.IsNullOrEmpty(Model.Cuisine) ? "selected" : string.Empty)"
           asp-page="/Index" asp-route-query="@Model.Query" asp-route-area="@Model.Area"
           asp-route-cuisine="" asp-route-priceLevel="@Model.PriceLevel"
           asp-route-date="@Model.Date.ToString("yyyy-MM-dd")" asp-route-time="@Model.Time"
           asp-route-guests="@Model.Guests"
           aria-current="@(string.IsNullOrEmpty(Model.Cuisine) ? "true" : null)">All cuisines</a>
        @foreach (var cuisine in Model.Cuisines)
        {
          <a class="chip @(Model.Cuisine == cuisine ? "selected" : string.Empty)"
             asp-page="/Index" asp-route-query="@Model.Query" asp-route-area="@Model.Area"
             asp-route-cuisine="@cuisine" asp-route-priceLevel="@Model.PriceLevel"
             asp-route-date="@Model.Date.ToString("yyyy-MM-dd")" asp-route-time="@Model.Time"
             asp-route-guests="@Model.Guests"
             aria-current="@(Model.Cuisine == cuisine ? "true" : null)">@cuisine</a>
        }
        <span class="chip-divider" aria-hidden="true"></span>
        <a class="chip @(string.IsNullOrEmpty(Model.Area) ? "selected" : string.Empty)"
           asp-page="/Index" asp-route-query="@Model.Query" asp-route-area=""
           asp-route-cuisine="@Model.Cuisine" asp-route-priceLevel="@Model.PriceLevel"
           asp-route-date="@Model.Date.ToString("yyyy-MM-dd")" asp-route-time="@Model.Time"
           asp-route-guests="@Model.Guests"
           aria-current="@(string.IsNullOrEmpty(Model.Area) ? "true" : null)">All areas</a>
        @foreach (var area in Model.Areas)
        {
          <a class="chip @(Model.Area == area ? "selected" : string.Empty)"
             asp-page="/Index" asp-route-query="@Model.Query" asp-route-area="@area"
             asp-route-cuisine="@Model.Cuisine" asp-route-priceLevel="@Model.PriceLevel"
             asp-route-date="@Model.Date.ToString("yyyy-MM-dd")" asp-route-time="@Model.Time"
             asp-route-guests="@Model.Guests"
             aria-current="@(Model.Area == area ? "true" : null)">@area</a>
        }
        <span class="chip-divider" aria-hidden="true"></span>
        <a class="chip @(Model.PriceLevel == 0 ? "selected" : string.Empty)"
           asp-page="/Index" asp-route-query="@Model.Query" asp-route-area="@Model.Area"
           asp-route-cuisine="@Model.Cuisine" asp-route-priceLevel="0"
           asp-route-date="@Model.Date.ToString("yyyy-MM-dd")" asp-route-time="@Model.Time"
           asp-route-guests="@Model.Guests"
           aria-current="@(Model.PriceLevel == 0 ? "true" : null)">Any price</a>
        @for (var level = 1; level <= 4; level++)
        {
          <a class="chip @(Model.PriceLevel == level ? "selected" : string.Empty)"
             asp-page="/Index" asp-route-query="@Model.Query" asp-route-area="@Model.Area"
             asp-route-cuisine="@Model.Cuisine" asp-route-priceLevel="@level"
             asp-route-date="@Model.Date.ToString("yyyy-MM-dd")" asp-route-time="@Model.Time"
             asp-route-guests="@Model.Guests"
             aria-current="@(Model.PriceLevel == level ? "true" : null)">Up to @(new string('R', level))</a>
        }
      </div>
    </div>

    <section class="restaurant-section" id="restaurants" aria-labelledby="restaurants-title">
      <h2 id="restaurants-title" class="visually-hidden">Restaurants</h2>
      <p class="result-count">@Model.Restaurants.Count @(Model.Restaurants.Count == 1 ? "restaurant" : "restaurants") with availability</p>
      @if (Model.Restaurants.Count == 0)
      {
        <div class="empty-state">
          <span aria-hidden="true">&#10035;</span>
          <h3>No tables found just yet</h3>
          <p>Try another date, time, or filter to discover more Cape Town favourites.</p>
          <a href="/">Clear your search <span aria-hidden="true">&#8599;</span></a>
        </div>
      }
      else
      {
        <div class="restaurant-grid">
          @foreach (var listing in Model.Restaurants)
          {
            var restaurant = listing.Restaurant;
            <article class="restaurant-card">
              <a class="card-image-link" asp-page="/Restaurants/Details" asp-route-slug="@restaurant.Slug"
                 asp-route-date="@Model.Date.ToString("yyyy-MM-dd")" asp-route-guests="@Model.Guests" tabindex="-1" aria-hidden="true">
                <img src="@restaurant.ImageUrl" alt="@restaurant.ImageAlt" loading="lazy">
                <span class="image-tag">@restaurant.Highlight</span>
              </a>
              <div class="card-content">
                <h3><a asp-page="/Restaurants/Details" asp-route-slug="@restaurant.Slug"
                       asp-route-date="@Model.Date.ToString("yyyy-MM-dd")" asp-route-guests="@Model.Guests">@restaurant.Name</a></h3>
                <p class="card-cuisine">@restaurant.Cuisine in @restaurant.Area</p>
                <p class="card-rating">
                  <span>@restaurant.Rating.ToString("0.0")</span><span class="star" aria-hidden="true">&#9733;</span>
                  <span class="meta-dot" aria-hidden="true">&bull;</span>
                  <span>@restaurant.ReviewCount reviews</span>
                  <span class="meta-dot" aria-hidden="true">&bull;</span>
                  <span>@restaurant.PriceLabel</span>
                </p>
                <div class="time-slots" aria-label="Available times">
                  @foreach (var slot in listing.AvailableTimes)
                  {
                    <a asp-page="/Restaurants/Details" asp-route-slug="@restaurant.Slug"
                       asp-route-date="@Model.Date.ToString("yyyy-MM-dd")" asp-route-guests="@Model.Guests"
                       asp-route-time="@ERPBooking.Booking.RestaurantCatalog.FormatTime(slot)">
                      @ERPBooking.Booking.RestaurantCatalog.FormatTime(slot)
                    </a>
                  }
                </div>
              </div>
            </article>
          }
        </div>
      }
    </section>

    <section class="how-section" id="how-it-works" aria-labelledby="how-title">
      <div class="how-intro">
        <p class="eyebrow">LESS SCROLLING, MORE SIPPING</p>
        <h2 id="how-title">Your table is<br><em>closer than you think.</em></h2>
      </div>
      <div class="how-step"><span>01</span><div><h3>Find your flavour</h3><p>Search by area, cuisine, or the kind of night you're after.</p></div></div>
      <div class="how-step"><span>02</span><div><h3>Pick your moment</h3><p>See available times for your date and party size.</p></div></div>
      <div class="how-step"><span>03</span><div><h3>Save your seat</h3><p>Share your details and get an instant booking reference.</p></div></div>
    </section>
  </main>

  <footer class="site-footer">
    <a class="brand" href="/"><span class="brand-icon" aria-hidden="true">C</span><span>Cape <span class="brand-amp">&amp;</span> Table</span></a>
    <p>Made for memorable meals in Cape Town.</p>
    <span>&copy; @DateTime.Today.Year Cape &amp; Table</span>
  </footer>
</body>
</html>
